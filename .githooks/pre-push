#!/usr/bin/env bash
# Pre-push hook — delegates to tools/quality/pre-push.sh, which never mutates the worktree.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

LOCAL_HOOK="$ROOT/.git/local-hooks/pre-push"
if [ -f "$LOCAL_HOOK" ]; then
  "$LOCAL_HOOK"
fi

ARGS=()
if [ "${OCTESSERA_PRE_PUSH_COMMITTED_TREE:-0}" = 1 ]; then
  ARGS+=(--committed-tree)
fi

exec "$ROOT/tools/quality/pre-push.sh" "${ARGS[@]}"
