[Unit]
Description=Octessera Orange Pi config-driven USB gadget
Wants=sys-kernel-config.mount
After=systemd-modules-load.service sys-kernel-config.mount local-fs.target octessera-provision-musical-default.service
Before=sound.target octessera.service
Requires=octessera-provision-musical-default.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/octessera-orange-usb-gadget setup
ExecStop=/usr/local/sbin/octessera-orange-usb-gadget teardown
ExecStopPost=-/sbin/modprobe -r usb_f_midi usb_f_uac2 libcomposite

[Install]
WantedBy=multi-user.target
