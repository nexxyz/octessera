[Unit]
Description=Octessera Orange Pi runtime
StartLimitIntervalSec=0
After=octessera-provision-musical-default.service octessera-orange-usb-gadget.service sound.target
Wants=octessera-orange-storage-control.socket
After=octessera-orange-storage-control.socket
Requires=octessera-device-apply-reboot.socket
Requires=octessera-provision-musical-default.service
After=octessera-device-apply-reboot.socket
Wants=octessera-orange-boot-splash.service
After=octessera-orange-boot-splash.service

[Service]
Type=simple
User=octessera-runtime
Group=octessera-runtime
Environment=OCTESSERA_EXPECTED_BOARD_PROFILE=orange-pi-zero-2w
Environment=OCTESSERA_PI_STORE_DIR=/var/lib/octessera/presets
Environment=OCTESSERA_PI_SAMPLES_DIR=/var/lib/octessera/samples
Environment=OCTESSERA_CANDIDATE_HEALTH_PATH=/run/octessera/candidate-ready.json
Environment=OCTESSERA_OLED_BOOT_HANDOFF=v1
RuntimeDirectory=octessera
RuntimeDirectoryMode=0755
TTYPath=/dev/tty1
SupplementaryGroups=audio i2c spi gpio tty video input
NoNewPrivileges=yes
AmbientCapabilities=CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
ProtectSystem=strict
ReadWritePaths=/var/lib/octessera /run/octessera /run/octessera-boot /run/octessera-setup-request/inbox
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
LimitRTPRIO=70
LimitMEMLOCK=infinity
Nice=-10
# systemd itself stays on CPU 0 with the other system daemons, off the audio core and the
# DSP workers; init.scope has no persistent drop-ins, so this is set at every start.
ExecStartPre=+-/bin/systemctl set-property --runtime init.scope AllowedCPUs=0
ExecStart=/usr/local/bin/octessera-pi
ExecStopPost=-+/usr/bin/python3 -c 'import fcntl;t=open("/dev/tty1","w");fcntl.ioctl(t,0x4B3A,0);fcntl.ioctl(t,0x5606,2)'
Restart=on-failure
RestartPreventExitStatus=78
SuccessExitStatus=75
RestartForceExitStatus=75
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
