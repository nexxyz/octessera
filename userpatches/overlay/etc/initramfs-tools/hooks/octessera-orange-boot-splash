#!/bin/sh
set -e

PREREQ=""

prereqs() {
  echo "$PREREQ"
}

case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

# shellcheck disable=SC1091
. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/local/sbin/octessera-orange-oled-logo /usr/local/sbin/octessera-orange-oled-logo
copy_exec /usr/bin/python3 /usr/bin/python3
copy_exec /usr/bin/gpiodetect /usr/bin/gpiodetect
copy_exec /usr/bin/gpioset /usr/bin/gpioset

copy_python_file() {
  python_file="$1"
  if [ ! -f "$python_file" ]; then
    echo "Orange initramfs hook missing Python target file: $python_file" >&2
    exit 1
  fi
  copy_file binary "$python_file" "$python_file"
}

copy_python_extension() {
  python_module="$1"
  python_extension_found=0
  for python_file in "$python_dir/lib-dynload/${python_module}"*.so; do
    if [ -f "$python_file" ]; then
      python_extension_found=1
      copy_exec "$python_file" "$python_file"
    fi
  done
  if [ "$python_extension_found" -eq 0 ]; then
    if ! /usr/bin/python3 -c "import $python_module" >/dev/null 2>&1; then
      echo "Orange initramfs hook missing Python target module: $python_module" >&2
      exit 1
    fi
  fi
}

python_stdlib_found=0
for python_dir in /usr/lib/python3.*; do
  if [ -d "$python_dir" ]; then
    python_stdlib_found=1
    for python_file in \
      "$python_dir/site.py" \
      "$python_dir/_sitebuiltins.py" \
      "$python_dir/abc.py" \
      "$python_dir/codecs.py" \
      "$python_dir/encodings/__init__.py" \
      "$python_dir/encodings/aliases.py" \
      "$python_dir/encodings/utf_8.py" \
      "$python_dir/io.py" \
      "$python_dir/os.py" \
      "$python_dir/re/__init__.py" \
      "$python_dir/re/_casefix.py" \
      "$python_dir/re/_compiler.py" \
      "$python_dir/re/_constants.py" \
      "$python_dir/re/_parser.py" \
      "$python_dir/_collections_abc.py" \
      "$python_dir/genericpath.py" \
      "$python_dir/posixpath.py" \
      "$python_dir/enum.py" \
      "$python_dir/types.py" \
      "$python_dir/functools.py" \
      "$python_dir/collections/__init__.py" \
      "$python_dir/keyword.py" \
      "$python_dir/operator.py" \
      "$python_dir/reprlib.py" \
      "$python_dir/copyreg.py" \
      "$python_dir/stat.py" \
      "$python_dir/signal.py" \
      "$python_dir/struct.py" \
      "$python_dir/subprocess.py" \
      "$python_dir/locale.py" \
      "$python_dir/threading.py" \
      "$python_dir/_weakrefset.py" \
      "$python_dir/warnings.py" \
      "$python_dir/contextlib.py" \
      "$python_dir/selectors.py"; do
      copy_python_file "$python_file"
    done
    for python_package in \
      "$python_dir/importlib/__init__.py" \
      "$python_dir/importlib/_abc.py" \
      "$python_dir/importlib/machinery.py" \
      "$python_dir/importlib/util.py"; do
      copy_python_file "$python_package"
    done
    for python_module in fcntl math _posixsubprocess select _struct zlib; do
      copy_python_extension "$python_module"
    done
  fi
done
if [ "$python_stdlib_found" -eq 0 ]; then
  echo "Orange initramfs hook missing Python target directory: /usr/lib/python3.*" >&2
  exit 1
fi
copy_file asset /usr/share/octessera/oled/octessera-mark.svg
copy_file asset /usr/share/octessera/oled/octessera-wordmark.svg
manual_add_modules spi-sun6i || true
manual_add_modules spidev || true
manual_add_modules pinctrl-sunxi || true
