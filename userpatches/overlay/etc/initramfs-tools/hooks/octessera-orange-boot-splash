#!/bin/sh
set -e

PREREQ=""

prereqs() {
  echo "$PREREQ"
}

case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

# shellcheck disable=SC1091
. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/local/sbin/octessera-orange-oled-logo /usr/local/sbin/octessera-orange-oled-logo
copy_file binary /usr/local/sbin/octessera-orange-oled-handoff.py /usr/local/sbin/octessera-orange-oled-handoff.py
copy_file binary /usr/local/sbin/octessera-orange-oled-lifecycle.py /usr/local/sbin/octessera-orange-oled-lifecycle.py
copy_exec /usr/bin/python3 /usr/bin/python3
copy_exec /usr/bin/setsid /usr/bin/setsid
copy_exec /usr/bin/gpioset /usr/bin/gpioset

copy_python_file() {
  python_file="$1"
  if [ ! -f "$python_file" ]; then
    echo "Orange initramfs hook missing Python target file: $python_file" >&2
    exit 1
  fi
  copy_file binary "$python_file" "$python_file"
}

copy_python_extension() {
  python_module="$1"
  if ! python_origin="$(/usr/bin/python3 -I -S - "$python_module" "$python_dir" <<'PY'
import importlib
import importlib.machinery
import importlib.util
from pathlib import Path
import sys

module_name = sys.argv[1]
python_dir = Path(sys.argv[2])
try:
    importlib.import_module(module_name)
    spec = importlib.util.find_spec(module_name)
except (ImportError, OSError):
    raise SystemExit(1)
if spec is None or spec.origin is None:
    raise SystemExit(1)
if spec.origin == "built-in":
    print("built-in")
    raise SystemExit(0)
if not isinstance(spec.loader, importlib.machinery.ExtensionFileLoader):
    raise SystemExit(1)
origin = Path(spec.origin)
dynload = python_dir / "lib-dynload"
try:
    resolved_origin = origin.resolve(strict=True)
    resolved_dynload = dynload.resolve(strict=True)
except OSError:
    raise SystemExit(1)
if (
    not origin.is_absolute()
    or origin.is_symlink()
    or not origin.is_file()
    or resolved_origin != origin
    or resolved_dynload != dynload
    or origin.parent != dynload
    or origin.name not in {module_name + suffix for suffix in importlib.machinery.EXTENSION_SUFFIXES}
):
    raise SystemExit(1)
print(origin)
PY
)"; then
    echo "Orange initramfs hook rejected Python target module: $python_module" >&2
    exit 1
  fi
  if [ "$python_origin" != "built-in" ]; then
    copy_exec "$python_origin" "$python_origin"
  fi
}

python_stdlib_found=0
for python_dir in /usr/lib/python3.*; do
  if [ -d "$python_dir" ]; then
    python_stdlib_found=1
    for python_file in \
      "$python_dir/site.py" \
      "$python_dir/_sitebuiltins.py" \
      "$python_dir/abc.py" \
      "$python_dir/codecs.py" \
      "$python_dir/encodings/__init__.py" \
      "$python_dir/encodings/aliases.py" \
      "$python_dir/encodings/utf_8.py" \
      "$python_dir/io.py" \
      "$python_dir/os.py" \
      "$python_dir/re/__init__.py" \
      "$python_dir/re/_casefix.py" \
      "$python_dir/re/_compiler.py" \
      "$python_dir/re/_constants.py" \
      "$python_dir/re/_parser.py" \
      "$python_dir/_collections_abc.py" \
      "$python_dir/genericpath.py" \
      "$python_dir/posixpath.py" \
      "$python_dir/enum.py" \
      "$python_dir/types.py" \
      "$python_dir/functools.py" \
      "$python_dir/collections/__init__.py" \
      "$python_dir/keyword.py" \
      "$python_dir/operator.py" \
      "$python_dir/reprlib.py" \
      "$python_dir/copyreg.py" \
      "$python_dir/stat.py" \
      "$python_dir/signal.py" \
      "$python_dir/struct.py" \
      "$python_dir/subprocess.py" \
      "$python_dir/locale.py" \
      "$python_dir/threading.py" \
      "$python_dir/_weakrefset.py" \
      "$python_dir/warnings.py" \
      "$python_dir/contextlib.py" \
      "$python_dir/selectors.py"; do
      copy_python_file "$python_file"
    done
    for python_file in \
      "$python_dir/json/__init__.py" \
      "$python_dir/json/decoder.py" \
      "$python_dir/json/encoder.py" \
      "$python_dir/json/scanner.py"; do
      copy_python_file "$python_file"
    done
    for python_package in \
      "$python_dir/importlib/__init__.py" \
      "$python_dir/importlib/_abc.py" \
      "$python_dir/importlib/machinery.py" \
      "$python_dir/importlib/util.py"; do
      copy_python_file "$python_package"
    done
    for python_module in fcntl math _json _posixsubprocess select _struct zlib; do
      copy_python_extension "$python_module"
    done
  fi
done
if [ "$python_stdlib_found" -eq 0 ]; then
  echo "Orange initramfs hook missing Python target directory: /usr/lib/python3.*" >&2
  exit 1
fi
copy_file asset /usr/share/octessera/oled/octessera-mark.svg
copy_file asset /usr/share/octessera/oled/octessera-wordmark.svg
