#!/bin/sh
set -e

PREREQ=""

prereqs() {
  echo "$PREREQ"
}

case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

modprobe spi-sun6i >/dev/null 2>&1 || true
modprobe spidev >/dev/null 2>&1 || true
modprobe pinctrl-sunxi >/dev/null 2>&1 || true

if [ -x /usr/local/sbin/octessera-orange-oled-logo ]; then
  /usr/local/sbin/octessera-orange-oled-logo boot >/dev/kmsg 2>&1 || true
fi
