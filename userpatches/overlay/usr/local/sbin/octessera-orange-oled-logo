#!/usr/bin/env python3
import fcntl
import importlib.util
from importlib.machinery import SourceFileLoader
import os
import math
import re
import stat
import signal
import struct
import subprocess
import sys
import time
import zlib

_handoff_loader = SourceFileLoader("octessera_orange_oled_handoff", os.path.join(os.path.dirname(__file__), "octessera-orange-oled-handoff.py"))
_handoff_spec = importlib.util.spec_from_loader("octessera_orange_oled_handoff", _handoff_loader)
_handoff_module = importlib.util.module_from_spec(_handoff_spec)
_handoff_spec.loader.exec_module(_handoff_module)
Handoff = _handoff_module.Handoff
validate_marker = _handoff_module.validate_marker
RUNTIME_USER = _handoff_module.RUNTIME_USER

GPIO_LABEL = "300b000.pinctrl"
GPIO_CHIP = "/dev/gpiochip1"
GPIO_RESET = 76
GPIO_DC = 270
SPI_DEVICE = "/dev/spidev1.0"
SPI_SPEED = 16_000_000
WIDTH = 128
HEIGHT = 128
MARK_SOURCE = "/usr/share/octessera/oled/octessera-mark.svg"
WORDMARK_SOURCE = "/usr/share/octessera/oled/octessera-wordmark.svg"
BOOT_SWEEP_FRAME_COUNT = 24
BOOT_SWEEP_DURATION_NS = 1_000_000_000
BOOT_SWEEP_FRAME_DELAY_SECONDS = BOOT_SWEEP_DURATION_NS / 1_000_000_000 / BOOT_SWEEP_FRAME_COUNT
BOOT_SWEEP_BAND_WIDTH = 8
BOOT_SWEEP_LEAN_PIXELS = 8
BOOT_SWEEP_COLORS_RGB565 = (0x07FF, 0xFFE0, 0x07E0, 0xF81F)
BOOT_SWEEP_COLORS = ((0, 255, 255), (255, 255, 0), (0, 255, 0), (255, 0, 255))
BOOT_SWEEP_CONTRACT_SHA256 = "698a1f3d2527c1d3c49028f33c7905db931985e3e30c3759ff9bdbebc9e7e754"
SPI_IOC_WR_MODE = 0x40016B01
SPI_IOC_WR_BITS_PER_WORD = 0x40016B03
SPI_IOC_WR_MAX_SPEED_HZ = 0x40046B04


class GpioLines:
    def __init__(self):
        try:
            metadata = os.stat(GPIO_CHIP)
        except OSError as error:
            raise RuntimeError(f"H618 GPIO controller {GPIO_LABEL} is missing: {GPIO_CHIP}") from error
        if not stat.S_ISCHR(metadata.st_mode):
            raise RuntimeError(f"H618 GPIO controller {GPIO_LABEL} is not a character device: {GPIO_CHIP}")
        self.chip = GPIO_CHIP
        self.processes = {}

    def set(self, name, offset, value):
        previous = self.processes.pop(name, None)
        if previous is not None:
            self._stop(previous)
        process = subprocess.Popen(
            ["gpioset", "--mode=wait", self.chip, f"{offset}={value}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        time.sleep(0.01)
        if process.poll() is not None:
            error = process.stderr.read().strip()
            raise RuntimeError(f"could not set H618 GPIO {offset}: {error}")
        self.processes[name] = process

    @staticmethod
    def _stop(process):
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=1)

    def close(self):
        for process in self.processes.values():
            self._stop(process)
        self.processes.clear()


class Oled:
    def __init__(self):
        if not os.path.exists(SPI_DEVICE):
            raise RuntimeError(f"H618 OLED SPI device is missing: {SPI_DEVICE}")
        self.spi = os.open(SPI_DEVICE, os.O_WRONLY)
        fcntl.ioctl(self.spi, SPI_IOC_WR_MODE, bytes([0]))
        fcntl.ioctl(self.spi, SPI_IOC_WR_BITS_PER_WORD, bytes([8]))
        fcntl.ioctl(self.spi, SPI_IOC_WR_MAX_SPEED_HZ, struct.pack("I", SPI_SPEED))
        self.gpio = GpioLines()

    def close(self, display_off=True):
        try:
            if display_off:
                self.command(0xAE)
        finally:
            self.gpio.close()
            os.close(self.spi)

    def write(self, payload):
        view = memoryview(payload)
        while view:
            written = os.write(self.spi, view[:4096])
            view = view[written:]

    def command(self, *values):
        self.gpio.set("dc", GPIO_DC, 0)
        self.write(bytes(values))

    def data(self, payload):
        self.gpio.set("dc", GPIO_DC, 1)
        self.write(payload)

    def reset(self):
        self.gpio.set("reset", GPIO_RESET, 1)
        time.sleep(0.35)
        self.gpio.set("reset", GPIO_RESET, 0)
        time.sleep(0.1)
        self.gpio.set("reset", GPIO_RESET, 1)
        time.sleep(0.25)

    def initialize(self):
        self.reset()
        self.command(0xFD, 0x12)
        self.command(0xFD, 0xB1)
        self.command(0xAE)
        self.command(0xB3, 0xF1)
        self.command(0xCA, 0x7F)
        self.command(0xA0, 0x74)
        self.command(0x15, 0x00, 0x7F)
        self.command(0x75, 0x00, 0x7F)
        self.command(0xA1, 0x00)
        self.command(0xA2, 0x00)
        self.command(0xB5, 0x00)
        self.command(0xAB, 0x01)
        self.command(0xB1, 0x32)
        self.command(0xBB, 0x17)
        self.command(0xBE, 0x05)
        self.command(0xA6)
        self.command(0xC1, 0xC8, 0x80, 0xC8)
        self.command(0xC7, 0x0F)
        self.command(0xB4, 0xA0, 0xB5, 0x55)
        self.command(0xB6, 0x01)
        self.command(0xAF)

    def frame(self, pixels):
        self.command(0x15, 0, WIDTH - 1)
        self.command(0x75, 0, HEIGHT - 1)
        self.command(0x5C)
        self.data(pixels)


def path_points(path):
    numbers = [float(value) for value in re.findall(r"-?\d+(?:\.\d+)?", path)]
    return [(numbers[index], numbers[index + 1]) for index in range(0, len(numbers), 2)]


def source_bounds(paths, circles):
    points = [point for points in paths for point in points]
    points.extend((x - radius, y - radius) for x, y, radius in circles)
    points.extend((x + radius, y + radius) for x, y, radius in circles)
    return min(x for x, _ in points), min(y for _, y in points), max(x for x, _ in points), max(y for _, y in points)


def transform(point, bounds, target, center):
    minimum_x, minimum_y, maximum_x, maximum_y = bounds
    scale = target / max(maximum_x - minimum_x, maximum_y - minimum_y)
    source_center = ((minimum_x + maximum_x) / 2, (minimum_y + maximum_y) / 2)
    return ((point[0] - source_center[0]) * scale + center[0], (point[1] - source_center[1]) * scale + center[1])


def pixel(canvas, x, y, value=255):
    if 0 <= x < WIDTH and 0 <= y < HEIGHT:
        canvas[y][x] = max(canvas[y][x], value)


def line(canvas, start, end, width):
    distance = max(abs(end[0] - start[0]), abs(end[1] - start[1]))
    steps = max(1, math.ceil(distance * 2))
    radius = width / 2
    for step in range(steps + 1):
        fraction = step / steps
        x = start[0] + (end[0] - start[0]) * fraction
        y = start[1] + (end[1] - start[1]) * fraction
        for target_y in range(math.floor(y - radius), math.ceil(y + radius) + 1):
            for target_x in range(math.floor(x - radius), math.ceil(x + radius) + 1):
                if (target_x + 0.5 - x) ** 2 + (target_y + 0.5 - y) ** 2 <= radius**2:
                    pixel(canvas, target_x, target_y)


def disk(canvas, center, radius):
    for y in range(math.floor(center[1] - radius), math.ceil(center[1] + radius) + 1):
        for x in range(math.floor(center[0] - radius), math.ceil(center[0] + radius) + 1):
            if (x + 0.5 - center[0]) ** 2 + (y + 0.5 - center[1]) ** 2 <= radius**2:
                pixel(canvas, x, y)


def fill_polygon(canvas, points):
    minimum_y = max(0, math.floor(min(y for _, y in points)))
    maximum_y = min(HEIGHT - 1, math.ceil(max(y for _, y in points)))
    for y in range(minimum_y, maximum_y + 1):
        intersections = []
        for start, end in zip(points, points[1:] + points[:1]):
            if (start[1] > y) != (end[1] > y):
                intersections.append(start[0] + (y - start[1]) * (end[0] - start[0]) / (end[1] - start[1]))
        intersections.sort()
        for start, end in zip(intersections[::2], intersections[1::2]):
            for x in range(math.floor(start), math.ceil(end) + 1):
                pixel(canvas, x, y)


def read_svg(path):
    source = open(path, encoding="utf-8").read()
    paths = [path_points(value) for value in re.findall(r'<path\s+d="([^"]+)"', source)]
    circles = [tuple(float(value) for value in match) for match in re.findall(r'<circle\s+cx="([^"]+)"\s+cy="([^"]+)"\s+r="([^"]+)"', source)]
    return paths, circles


def logo_canvas(kind):
    mark_paths, circles = read_svg(MARK_SOURCE)
    canvas = [[0 for _ in range(WIDTH)] for _ in range(HEIGHT)]
    mark_bounds = source_bounds(mark_paths, circles)
    target = 58 if kind == "boot" else 80
    center = (64, 52) if kind == "boot" else (64, 64)
    for points in mark_paths:
        transformed = [transform(point, mark_bounds, target, center) for point in points]
        for start, end in zip(transformed, transformed[1:]):
            line(canvas, start, end, 6.5 * target / max(mark_bounds[2] - mark_bounds[0], mark_bounds[3] - mark_bounds[1]))
    for x, y, radius in circles:
        disk(canvas, transform((x, y), mark_bounds, target, center), radius * target / max(mark_bounds[2] - mark_bounds[0], mark_bounds[3] - mark_bounds[1]))
    if kind == "boot":
        wordmark_paths, _ = read_svg(WORDMARK_SOURCE)
        for points in wordmark_paths:
            transformed = [((point[0] / 52) * 106 + 11, (point[1] / 7) * 16 + 85) for point in points]
            fill_polygon(canvas, transformed)
    return canvas


def sweep_band_left(frame, y):
    if not 0 <= frame < BOOT_SWEEP_FRAME_COUNT:
        raise ValueError(f"boot sweep frame must be in [0, {BOOT_SWEEP_FRAME_COUNT})")
    origin = -40 + (frame * 168) // (BOOT_SWEEP_FRAME_COUNT - 1)
    return origin + (y * BOOT_SWEEP_LEAN_PIXELS) // (HEIGHT - 1)


def sweep_deadline_offset_ns(frame):
    if not 0 <= frame < BOOT_SWEEP_FRAME_COUNT:
        raise ValueError(f"boot sweep frame must be in [0, {BOOT_SWEEP_FRAME_COUNT})")
    return (frame * BOOT_SWEEP_DURATION_NS) // BOOT_SWEEP_FRAME_COUNT


def rgb565_color(color):
    red, green, blue = color
    return ((red & 0xF8) << 8) | ((green & 0xFC) << 3) | (blue >> 3)


def apply_sweep(rotated, frame):
    if not 0 <= frame < BOOT_SWEEP_FRAME_COUNT:
        raise ValueError(f"boot sweep frame must be in [0, {BOOT_SWEEP_FRAME_COUNT})")
    for controller_row in range(HEIGHT):
        contract_y = HEIGHT - 1 - controller_row
        for x in range(WIDTH):
            offset = (controller_row * WIDTH + x) * 2
            if rotated[offset:offset + 2] != b"\xff\xff":
                continue
            left = sweep_band_left(frame, contract_y)
            local_x = x - left
            if 0 <= local_x < 32:
                rotated[offset:offset + 2] = BOOT_SWEEP_COLORS_RGB565[int(local_x // 8)].to_bytes(2, "big")
    return rotated


def render_canvas(canvas, frame=None):
    pixels = bytearray()
    for row in canvas:
        for value in row:
            pixels.extend(rgb565(value).to_bytes(2, "big"))
    rotated = rotate_clockwise_rgb565(pixels)
    if frame is None:
        return rotated
    return apply_sweep(rotated, frame)


def render_logo(kind, frame=None):
    return render_canvas(logo_canvas(kind), frame)


def rgb565(value):
    return ((value & 0xF8) << 8) | ((value & 0xFC) << 3) | (value >> 3)


def rotate_clockwise_rgb565(pixels):
    expected = WIDTH * HEIGHT * 2
    if len(pixels) != expected:
        raise ValueError(f"expected {expected} RGB565 bytes, got {len(pixels)}")
    rotated = bytearray(expected)
    for y in range(HEIGHT):
        for x in range(WIDTH):
            source = (y * WIDTH + x) * 2
            destination = (x * WIDTH + (WIDTH - 1 - y)) * 2
            rotated[destination:destination + 2] = pixels[source:source + 2]
    return rotated


def _sleep_until(deadline):
    remaining = deadline - time.monotonic_ns()
    if remaining > 0:
        time.sleep(remaining / 1_000_000_000)


def render_sweep(oled, canvas):
    cycle_start = time.monotonic_ns()
    for frame in range(BOOT_SWEEP_FRAME_COUNT):
        _sleep_until(cycle_start + sweep_deadline_offset_ns(frame))
        oled.frame(render_canvas(canvas, frame))


def _run_once():
    oled = Oled()
    try:
        oled.initialize()
        render_sweep(oled, logo_canvas("boot"))
    finally:
        oled.close(False)


def _run_static(kind, adopt=False):
    oled = Oled()
    try:
        if not adopt:
            oled.initialize()
        oled.frame(render_canvas(logo_canvas(kind)))
    finally:
        oled.close(False)


def _run_loop():
    handoff = Handoff.open(True)
    oled = None
    try:
        handoff.start()
        adopt_existing = validate_marker()
        oled = Oled()
        if not adopt_existing:
            oled.initialize()
        canvas = logo_canvas("boot")
        if adopt_existing:
            oled.command(0xAF)
        cycle_start = time.monotonic_ns()
        frame = 0
        while True:
            _sleep_until(cycle_start + sweep_deadline_offset_ns(frame))
            oled.frame(render_canvas(canvas, frame))
            if handoff.stop_requested():
                oled.close(False)
                oled = None
                handoff.release()
                return
            if frame == BOOT_SWEEP_FRAME_COUNT - 1:
                cycle_start += BOOT_SWEEP_DURATION_NS
                handoff.publish_cycle()
                frame = 0
            else:
                frame += 1
    except Exception:
        handoff.mark_failed()
        raise
    finally:
        if oled is not None:
            oled.close(False)
        handoff.close()


def _run_resume():
    handoff = Handoff.utility_lock(_handoff_module.UTILITY_LOCK_TIMEOUT_SECONDS)
    try:
        status = handoff._read_status()
        if status is None or status["bootId"] != handoff.boot_id or status["phase"] not in {"released", "native_owned", "first_menu_rendered"}:
            raise RuntimeError("OLED resume requires an initialized native handoff")
        _run_static("boot", adopt=True)
    finally:
        handoff.close()


def drop_to_runtime():
    runtime_uid, runtime_gid = _handoff_module.runtime_identity()
    if os.geteuid() == runtime_uid and os.getegid() == runtime_gid:
        return
    if os.geteuid() != 0:
        raise RuntimeError("OLED utility requires the fixed runtime identity")
    os.initgroups(RUNTIME_USER, runtime_gid)
    os.setgid(runtime_gid)
    os.setuid(runtime_uid)
    if os.geteuid() != runtime_uid or os.getegid() != runtime_gid:
        raise RuntimeError("OLED utility failed to drop to the fixed runtime identity")


def _run_utility(kind, timeout_seconds):
    try:
        handoff = Handoff.utility_lock(timeout_seconds)
    except TimeoutError:
        return
    try:
        _run_static(kind)
    finally:
        handoff.close()


def run(kind):
    if kind == "boot-once":
        _run_once()
    elif kind == "boot-loop":
        _run_loop()
    elif kind == "resume":
        drop_to_runtime()
        try:
            _run_resume()
        except TimeoutError:
            return
    elif kind == "sleep":
        drop_to_runtime()
        _run_utility(kind, _handoff_module.UTILITY_LOCK_TIMEOUT_SECONDS)
    elif kind == "shutdown":
        drop_to_runtime()
        _run_utility(kind, _handoff_module.SHUTDOWN_LOCK_TIMEOUT_SECONDS)
    else:
        raise ValueError("unsupported OLED boot mode")


def parse_mode(args):
    if len(args) != 1 or args[0] not in {"boot-once", "boot-loop", "resume", "sleep", "shutdown"}:
        raise ValueError("usage: octessera-orange-oled-logo boot-once|boot-loop|resume|sleep|shutdown")
    return args[0]


def main():
    run(parse_mode(sys.argv[1:]))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"octessera-orange-oled-logo: {error}", file=sys.stderr)
        raise SystemExit(1)
