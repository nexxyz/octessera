#!/usr/bin/env python3
import fcntl
import importlib.util
from importlib.machinery import SourceFileLoader
import os
import stat
import signal
import struct
import subprocess
import sys
import time

_handoff_loader = SourceFileLoader("octessera_orange_oled_handoff", os.path.join(os.path.dirname(__file__), "octessera-orange-oled-handoff.py"))
_handoff_spec = importlib.util.spec_from_loader("octessera_orange_oled_handoff", _handoff_loader)
_handoff_module = importlib.util.module_from_spec(_handoff_spec)
_handoff_spec.loader.exec_module(_handoff_module)
Handoff = _handoff_module.Handoff
RUNTIME_USER = _handoff_module.RUNTIME_USER
_lifecycle_loader = SourceFileLoader("octessera_orange_oled_lifecycle", os.path.join(os.path.dirname(__file__), "octessera-orange-oled-lifecycle.py"))
_lifecycle_spec = importlib.util.spec_from_loader("octessera_orange_oled_lifecycle", _lifecycle_loader)
_lifecycle_module = importlib.util.module_from_spec(_lifecycle_spec)
_lifecycle_spec.loader.exec_module(_lifecycle_module)

GPIO_LABEL = "300b000.pinctrl"
GPIO_CHIP = "/dev/gpiochip1"
GPIO_RESET = 76
GPIO_DC = 270
SPI_DEVICE = "/dev/spidev1.0"
SPI_SPEED = 16_000_000
WIDTH = 128
HEIGHT = 128
FRAME_BYTES = WIDTH * HEIGHT * 2
BOOT_RGB565_SOURCE = "/usr/share/octessera/oled/octessera-pi-booting.rgb565"
SHUTDOWN_RGB565_SOURCE = "/usr/share/octessera/oled/octessera-pi-shutdown.rgb565"
BOOT_SWEEP_FRAME_COUNT = 30
BOOT_SWEEP_DURATION_NS = 1_200_000_000
BOOT_SWEEP_REST_NS = 2_000_000_000
BOOT_SWEEP_REST_CHECK_NS = 50_000_000
BOOT_SWEEP_FRAME_DELAY_SECONDS = BOOT_SWEEP_DURATION_NS / 1_000_000_000 / BOOT_SWEEP_FRAME_COUNT
BOOT_SWEEP_BAND_WIDTH = 8
BOOT_SWEEP_SEPARATOR_WIDTH = 4
BOOT_SWEEP_SEPARATOR_COLOR_RGB565 = 0xFFFF
BOOT_SWEEP_LEAN_PIXELS = -1
BOOT_SWEEP_LEAN_DENOMINATOR = 1
BOOT_SWEEP_TRAIN_WIDTH = 48
BOOT_SWEEP_COLORS_RGB565 = (0xF81F, 0x07E0, 0xFFE0, 0x07FF)
BOOT_SWEEP_COLORS = ((255, 0, 255), (0, 255, 0), (255, 255, 0), (0, 255, 255))
BOOT_SWEEP_CONTRACT_SHA256 = "18dabe8ebf4ba27dc36c23c0a5f3d91ed816f205ce796583b19c3ba4b9e7a2af"
NATIVE_HANDOFF_PHASES = {"released", "native_owned", "first_menu_rendered"}
NATIVE_HANDOFF_TIMEOUT_SECONDS = 30
READY_NOTIFY_REQUIRED_ENV = "OCTESSERA_OLED_READY_NOTIFY_REQUIRED"
SPI_IOC_WR_MODE = 0x40016B01
SPI_IOC_WR_BITS_PER_WORD = 0x40016B03
SPI_IOC_WR_MAX_SPEED_HZ = 0x40046B04


class GpioLines:
    def __init__(self):
        try:
            metadata = os.stat(GPIO_CHIP)
        except OSError as error:
            raise RuntimeError(f"H618 GPIO controller {GPIO_LABEL} is missing: {GPIO_CHIP}") from error
        if not stat.S_ISCHR(metadata.st_mode):
            raise RuntimeError(f"H618 GPIO controller {GPIO_LABEL} is not a character device: {GPIO_CHIP}")
        self.chip = GPIO_CHIP
        self.processes = {}

    def set(self, name, offset, value):
        previous = self.processes.get(name)
        if previous is not None:
            previous_value, previous_process = previous
            if previous_process.poll() is not None:
                raise RuntimeError(f"H618 GPIO {name} holder exited unexpectedly")
            if previous_value == value:
                return
            self.processes.pop(name)
            self._stop(previous_process)
        process = subprocess.Popen(
            ["gpioset", "--chip", self.chip, f"{offset}={value}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        time.sleep(0.01)
        if process.poll() is not None:
            error = process.stderr.read().strip()
            raise RuntimeError(f"could not set H618 GPIO {offset}: {error}")
        self.processes[name] = (value, process)

    @staticmethod
    def _stop(process):
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=1)

    def close(self):
        for _, process in self.processes.values():
            self._stop(process)
        self.processes.clear()


class Oled:
    def __init__(self):
        if not os.path.exists(SPI_DEVICE):
            raise RuntimeError(f"H618 OLED SPI device is missing: {SPI_DEVICE}")
        self.spi = os.open(SPI_DEVICE, os.O_WRONLY)
        fcntl.ioctl(self.spi, SPI_IOC_WR_MODE, bytes([0]))
        fcntl.ioctl(self.spi, SPI_IOC_WR_BITS_PER_WORD, bytes([8]))
        fcntl.ioctl(self.spi, SPI_IOC_WR_MAX_SPEED_HZ, struct.pack("I", SPI_SPEED))
        self.gpio = GpioLines()

    def close(self, display_off=True):
        try:
            if display_off:
                self.command(0xAE)
        finally:
            self.gpio.close()
            os.close(self.spi)

    def write(self, payload):
        view = memoryview(payload)
        while view:
            written = os.write(self.spi, view[:4096])
            view = view[written:]

    def command(self, *values):
        self.gpio.set("dc", GPIO_DC, 0)
        self.write(bytes(values[:1]))
        if len(values) > 1:
            self.data(bytes(values[1:]))

    def data(self, payload):
        self.gpio.set("dc", GPIO_DC, 1)
        self.write(payload)

    def reset(self):
        self.gpio.set("reset", GPIO_RESET, 1)
        time.sleep(0.35)
        self.gpio.set("reset", GPIO_RESET, 0)
        time.sleep(0.1)
        self.gpio.set("reset", GPIO_RESET, 1)
        time.sleep(0.25)

    def initialize(self):
        self.reset()
        self.command(0xFD, 0x12)
        self.command(0xFD, 0xB1)
        self.command(0xAE)
        self.command(0xB3, 0xF1)
        self.command(0xCA, 0x7F)
        self.command(0xA0, 0x74)
        self.command(0x15, 0x00, 0x7F)
        self.command(0x75, 0x00, 0x7F)
        self.command(0xA1, 0x00)
        self.command(0xA2, 0x00)
        self.command(0xB5, 0x00)
        self.command(0xAB, 0x01)
        self.command(0xB1, 0x32)
        self.command(0xBB, 0x17)
        self.command(0xBE, 0x05)
        self.command(0xA6)
        self.command(0xC1, 0xC8, 0x80, 0xC8)
        self.command(0xC7, 0x0F)
        self.command(0xB4, 0xA0, 0xB5, 0x55)
        self.command(0xB6, 0x01)
        self.command(0xAF)

    def frame(self, pixels):
        self.begin_frame_stream()
        self.stream_frame(pixels)

    def begin_frame_stream(self):
        self.command(0x15, 0, WIDTH - 1)
        self.command(0x75, 0, HEIGHT - 1)
        self.command(0x5C)
        self.gpio.set("dc", GPIO_DC, 1)

    def stream_frame(self, pixels):
        if len(pixels) != FRAME_BYTES:
            raise ValueError(f"OLED stream frame must contain exactly {FRAME_BYTES} bytes")
        self.write(pixels)

def open_cleanup_oled():
    return Oled()


def logo_canvas(kind):
    source = BOOT_RGB565_SOURCE if kind == "boot" else SHUTDOWN_RGB565_SOURCE
    with open(source, "rb") as handle:
        pixels = bytearray(handle.read())
    expected = WIDTH * HEIGHT * 2
    if len(pixels) != expected:
        raise ValueError(f"{source} must contain exactly {expected} RGB565 bytes")
    return pixels


def sweep_band_left(frame, y):
    if not 0 <= frame < BOOT_SWEEP_FRAME_COUNT:
        raise ValueError(f"boot sweep frame must be in [0, {BOOT_SWEEP_FRAME_COUNT})")
    origin = 255 - (frame * 303) // (BOOT_SWEEP_FRAME_COUNT - 1)
    return origin + (y * BOOT_SWEEP_LEAN_PIXELS) // BOOT_SWEEP_LEAN_DENOMINATOR


def sweep_deadline_offset_ns(frame):
    if not 0 <= frame < BOOT_SWEEP_FRAME_COUNT:
        raise ValueError(f"boot sweep frame must be in [0, {BOOT_SWEEP_FRAME_COUNT})")
    return (frame * BOOT_SWEEP_DURATION_NS) // BOOT_SWEEP_FRAME_COUNT


def rgb565_color(color):
    red, green, blue = color
    return ((red & 0xF8) << 8) | ((green & 0xFC) << 3) | (blue >> 3)


def apply_sweep(rotated, frame):
    if not 0 <= frame < BOOT_SWEEP_FRAME_COUNT:
        raise ValueError(f"boot sweep frame must be in [0, {BOOT_SWEEP_FRAME_COUNT})")
    for controller_row in range(HEIGHT):
        contract_y = HEIGHT - 1 - controller_row
        for x in range(WIDTH):
            offset = (controller_row * WIDTH + x) * 2
            if rotated[offset:offset + 2] != b"\xff\xff":
                continue
            left = sweep_band_left(frame, contract_y)
            local_x = x - left
            if 0 <= local_x < BOOT_SWEEP_TRAIN_WIDTH:
                band_position = local_x % (BOOT_SWEEP_BAND_WIDTH + BOOT_SWEEP_SEPARATOR_WIDTH)
                color = BOOT_SWEEP_SEPARATOR_COLOR_RGB565 if band_position < BOOT_SWEEP_SEPARATOR_WIDTH else BOOT_SWEEP_COLORS_RGB565[(local_x - BOOT_SWEEP_SEPARATOR_WIDTH) // (BOOT_SWEEP_BAND_WIDTH + BOOT_SWEEP_SEPARATOR_WIDTH)]
                rotated[offset:offset + 2] = color.to_bytes(2, "big")
    return rotated


def render_canvas(canvas, frame=None):
    rotated = rotate_clockwise_rgb565(canvas)
    if frame is None:
        return rotated
    return apply_sweep(rotated, frame)


def render_logo(kind, frame=None):
    return render_canvas(logo_canvas(kind), frame)


def rotate_clockwise_rgb565(pixels):
    expected = WIDTH * HEIGHT * 2
    if len(pixels) != expected:
        raise ValueError(f"expected {expected} RGB565 bytes, got {len(pixels)}")
    rotated = bytearray(expected)
    for y in range(HEIGHT):
        for x in range(WIDTH):
            source = (y * WIDTH + x) * 2
            destination = (x * WIDTH + (WIDTH - 1 - y)) * 2
            rotated[destination:destination + 2] = pixels[source:source + 2]
    return rotated


def _sleep_until(deadline):
    remaining = deadline - time.monotonic_ns()
    if remaining > 0:
        time.sleep(remaining / 1_000_000_000)


def render_sweep(oled, canvas):
    frames = [render_canvas(canvas, frame) for frame in range(BOOT_SWEEP_FRAME_COUNT)]
    clean_frame = render_canvas(canvas)
    notify_systemd_ready()
    oled.begin_frame_stream()
    cycle_start = time.monotonic_ns()
    for frame in range(BOOT_SWEEP_FRAME_COUNT):
        _sleep_until(cycle_start + sweep_deadline_offset_ns(frame))
        oled.stream_frame(frames[frame])
    _sleep_until(cycle_start + BOOT_SWEEP_DURATION_NS)
    oled.stream_frame(clean_frame)


def notify_systemd_ready():
    if os.environ.get(READY_NOTIFY_REQUIRED_ENV) != "1":
        return
    notify_socket = os.environ.get("NOTIFY_SOCKET")
    if not notify_socket:
        raise RuntimeError("systemd OLED readiness notification is required but NOTIFY_SOCKET is missing")
    import socket

    address = notify_socket
    if address.startswith("@"):
        address = "\0" + address[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sender:
            sender.sendto(b"READY=1\n", address)
    except OSError as error:
        raise RuntimeError(f"systemd OLED readiness notification failed: {error}") from error


def _run_once():
    _run_static("boot")


def _run_static(kind, adopt=False):
    oled = Oled()
    try:
        if not adopt:
            oled.initialize()
        oled.frame(render_canvas(logo_canvas(kind)))
    finally:
        oled.close(False)


def _run_off():
    oled = Oled()
    try:
        oled.command(0xAE)
    finally:
        oled.close(False)


def _run_loop():
    return _lifecycle_module.run_loop(globals())


def _run_resume():
    handoff = Handoff.utility_lock(_handoff_module.UTILITY_LOCK_TIMEOUT_SECONDS)
    try:
        status = handoff._read_status()
        if status is None or status["bootId"] != handoff.boot_id or status["phase"] not in {"released", "native_owned", "first_menu_rendered"}:
            raise RuntimeError("OLED resume requires an initialized native handoff")
        _run_static("boot", adopt=True)
    finally:
        handoff.close()


def drop_to_runtime():
    runtime_uid, runtime_gid = _handoff_module.runtime_identity()
    if os.geteuid() == runtime_uid and os.getegid() == runtime_gid:
        return
    if os.geteuid() != 0:
        raise RuntimeError("OLED utility requires the fixed runtime identity")
    os.initgroups(RUNTIME_USER, runtime_gid)
    os.setgid(runtime_gid)
    os.setuid(runtime_uid)
    if os.geteuid() != runtime_uid or os.getegid() != runtime_gid:
        raise RuntimeError("OLED utility failed to drop to the fixed runtime identity")


def _run_utility(kind, timeout_seconds):
    try:
        handoff = Handoff.utility_lock(timeout_seconds)
    except TimeoutError:
        return
    try:
        if kind == "off":
            _run_off()
        else:
            _run_static(kind)
    finally:
        handoff.close()


def run(kind):
    if kind in {"boot-once", "boot-static"}:
        _run_once()
    elif kind == "boot-loop":
        _run_loop()
    elif kind == "resume":
        drop_to_runtime()
        try:
            _run_resume()
        except TimeoutError:
            return
    elif kind == "sleep":
        drop_to_runtime()
        _run_utility(kind, _handoff_module.UTILITY_LOCK_TIMEOUT_SECONDS)
    elif kind == "shutdown":
        drop_to_runtime()
        _run_utility(kind, _handoff_module.SHUTDOWN_LOCK_TIMEOUT_SECONDS)
    elif kind == "off":
        drop_to_runtime()
        _run_utility(kind, _handoff_module.UTILITY_LOCK_TIMEOUT_SECONDS)
    else:
        raise ValueError("unsupported OLED boot mode")


def parse_mode(args):
    if len(args) != 1 or args[0] not in {"boot-once", "boot-static", "boot-loop", "resume", "sleep", "shutdown", "off"}:
        raise ValueError("usage: octessera-orange-oled-logo boot-once|boot-static|boot-loop|resume|sleep|shutdown|off")
    return args[0]


def main():
    run(parse_mode(sys.argv[1:]))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"octessera-orange-oled-logo: {error}", file=sys.stderr)
        raise SystemExit(1)
