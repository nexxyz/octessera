#!/bin/sh
# Live Show Mode and the Wi-Fi switch, applied as root. They are independent:
# the show blocks the radio (rfkill) only while it lasts; the switch turns
# NetworkManager's radio off until it is turned back on, so ending or timing
# out a show never changes it.
#
# The runtime writes the show length in seconds to `length` and removes it on
# End. The show counts powered time on the monotonic clock, never the wall
# clock: a transient timer re-runs this script as `tick <seconds> <show>` at
# most five minutes apart, each tick banks its seconds in `elapsed` (keyed to that
# show's `length` file), and a reboot resumes from the banked total. The show
# is over, and `length` removed, once the banked time reaches the length.
set -eu

dir=${OCTESSERA_SHOW_HOLD_DIR:-/var/lib/octessera/show-hold}
release=octessera-show-hold-release
step=300
# One run at a time: a tick and a path-unit apply must not both arm a timer.
exec 9>"$dir/.lock"
flock 9

if [ -e "$dir/wifi-off" ]; then
    nmcli radio wifi off || true
else
    nmcli radio wifi on || true
fi

# Each tick gets its own unit name: a running tick cannot re-arm a timer under
# the name of its own still-loaded service.
systemctl stop "$release-*.timer" >/dev/null 2>&1 || true
systemctl reset-failed "$release-*" >/dev/null 2>&1 || true

length=$(cat "$dir/length" 2>/dev/null || true)
case "$length" in ""|*[!0-9]*) length=0 ;; esac
show=$(stat -c '%i %Y' "$dir/length" 2>/dev/null || true)
elapsed=0
if [ -n "$show" ] && [ "$(sed -n 1p "$dir/elapsed" 2>/dev/null)" = "$show" ]; then
    elapsed=$(sed -n 2p "$dir/elapsed")
    case "$elapsed" in ""|*[!0-9]*) elapsed=0 ;; esac
fi
if [ "${1:-}" = tick ] && [ -n "$show" ] && [ "${3:-}" = "$show" ]; then
    elapsed=$((elapsed + $2))
    printf '%s\n%s\n' "$show" "$elapsed" >"$dir/elapsed.tmp"
    mv "$dir/elapsed.tmp" "$dir/elapsed"
fi

left=$((length - elapsed))
if [ "$left" -gt 0 ]; then
    rfkill block wlan
    next=$((left < step ? left : step))
    systemd-run --quiet --unit="$release-$(cut -d. -f1 /proc/uptime)-$$" --on-active="$next" \
        --timer-property=AccuracySec=1s /usr/local/sbin/octessera-show-hold-apply tick "$next" "$show"
else
    rm -f "$dir/length" "$dir/elapsed"
    rfkill unblock wlan
fi

