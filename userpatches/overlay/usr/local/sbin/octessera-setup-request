#!/usr/bin/env python3
import json
import os
import secrets
import signal
import stat
import subprocess
import sys
import time


PROFILE = "orange-pi-zero-2w"
REQUEST_OWNER = "octessera-runtime"
REQUEST_PATH = "/run/octessera/setup-portal.request"
CONTROL_DIR = "/run/octessera-setup-control"
CLAIM_DIR = os.path.join(CONTROL_DIR, "claims")
PROFILE_PATH = "/etc/octessera/setup-profile"
STATUS_TOOL = "/usr/local/lib/octessera/setup-status.py"
SETUP_UNIT = "octessera-setup.service"
MAX_AGE_SECONDS = 10


def _profile_is_valid():
    try:
        metadata = os.lstat(PROFILE_PATH)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o644:
            return False
        with open(PROFILE_PATH, "rb") as handle:
            return handle.read() == f"{PROFILE}\n".encode("ascii")
    except (OSError, UnicodeError):
        return False


def _expected_owner_uid():
    try:
        import pwd

        return pwd.getpwnam(REQUEST_OWNER).pw_uid
    except (ImportError, KeyError):
        return -1


def _valid_request_metadata(metadata, expected_uid, now):
    age = now - metadata.st_mtime
    return stat.S_ISREG(metadata.st_mode) and metadata.st_uid == expected_uid and stat.S_IMODE(metadata.st_mode) == 0o600 and metadata.st_nlink == 1 and metadata.st_size == 33 and 0 <= age < MAX_AGE_SECONDS


def _ensure_control():
    if os.path.lexists(CONTROL_DIR):
        metadata = os.lstat(CONTROL_DIR)
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700:
            raise OSError("unsafe setup control directory")
    else:
        os.mkdir(CONTROL_DIR, 0o700)
        os.chown(CONTROL_DIR, 0, 0)
        os.chmod(CONTROL_DIR, 0o700)
    if os.path.lexists(CLAIM_DIR):
        metadata = os.lstat(CLAIM_DIR)
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700:
            raise OSError("unsafe setup claims directory")
    else:
        os.mkdir(CLAIM_DIR, 0o700)
        os.chown(CLAIM_DIR, 0, 0)
        os.chmod(CLAIM_DIR, 0o700)
    if os.stat(os.path.dirname(REQUEST_PATH)).st_dev != os.stat(CLAIM_DIR).st_dev:
        raise OSError("setup claim is not on the request filesystem")


def _read_token(descriptor):
    os.lseek(descriptor, 0, os.SEEK_SET)
    token = os.read(descriptor, 34)
    if len(token) != 33 or token[32:] != b"\n" or any(byte not in b"0123456789abcdef" for byte in token[:32]):
        raise ValueError("invalid request token")
    return token[:32].decode("ascii")


def _delete_claim(claim_path, inode):
    try:
        metadata = os.lstat(claim_path)
        if (metadata.st_dev, metadata.st_ino) != inode:
            return
        if stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
            os.unlink(claim_path)
    except FileNotFoundError:
        pass


def _claim_request():
    expected_uid = _expected_owner_uid()
    if expected_uid < 0:
        raise ValueError("missing request owner")
    try:
        source_metadata = os.lstat(REQUEST_PATH)
    except FileNotFoundError:
        return None
    source_inode = (source_metadata.st_dev, source_metadata.st_ino)
    _ensure_control()
    claim_path = os.path.join(CLAIM_DIR, f"claim-{secrets.token_hex(16)}")
    try:
        os.rename(REQUEST_PATH, claim_path)
    except FileNotFoundError:
        return None
    claim_inode = (source_metadata.st_dev, source_metadata.st_ino)
    claimed = None
    try:
        claim_metadata = os.lstat(claim_path)
        claim_inode = (claim_metadata.st_dev, claim_metadata.st_ino)
        if claim_inode != source_inode:
            return None
        try:
            descriptor = os.open(claim_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError:
            return None
        try:
            metadata = os.fstat(descriptor)
            if (metadata.st_dev, metadata.st_ino) != claim_inode or not _valid_request_metadata(metadata, expected_uid, time.time()):
                return None
            token = _read_token(descriptor)
            os.fchown(descriptor, 0, 0)
            os.fchmod(descriptor, 0o600)
            final = os.fstat(descriptor)
            if not stat.S_ISREG(final.st_mode) or final.st_uid != 0 or stat.S_IMODE(final.st_mode) != 0o600 or final.st_nlink != 1 or final.st_size != 33:
                return None
            claimed = (claim_path, token, claim_inode)
            return claimed
        finally:
            os.close(descriptor)
    finally:
        if claimed is None:
            _delete_claim(claim_path, claim_inode)


def _status(args, capture=False):
    return subprocess.run([sys.executable, STATUS_TOOL, *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE if capture else subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True, check=False)


def _decision(result):
    if result.returncode != 0:
        return None
    try:
        value = json.loads(result.stdout)
    except (TypeError, ValueError):
        return None
    if not isinstance(value, dict) or value.get("decision") not in {"new", "attached", "failed", "replayed"} or not isinstance(value.get("attemptId"), str):
        return None
    return value


def _fail_start(token):
    try:
        _status(["start-failed", token])
    except (OSError, subprocess.SubprocessError, ValueError):
        pass


def main():
    if not _profile_is_valid():
        return 1
    claimed = _claim_request()
    if claimed is None:
        return 0
    claim_path, token, inode = claimed
    pending = False
    try:
        decision = _decision(_status(["start-or-attach", token, "1", claim_path], capture=True))
        if decision is None:
            return 1
        if decision["decision"] != "new":
            return 0
        pending = True
        def interrupted(signum, _frame):
            _fail_start(token)
            raise SystemExit(128 + signum)
        signal.signal(signal.SIGINT, interrupted)
        signal.signal(signal.SIGTERM, interrupted)
        service = subprocess.run(["systemctl", "start", SETUP_UNIT], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if service.returncode != 0:
            return 1
        pending = False
        return 0
    except (OSError, subprocess.SubprocessError, ValueError):
        return 1
    finally:
        if pending:
            _fail_start(token)
        _delete_claim(claim_path, inode)


if __name__ == "__main__":
    raise SystemExit(main())
