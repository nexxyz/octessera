#!/bin/sh
set -eu

root_prefix=${OCTESSERA_PROVISION_ROOT:-}
source_default="${root_prefix}/usr/share/octessera/defaults/pi-default.json"
state_directory="${root_prefix}/var/lib/octessera"
presets_directory="$state_directory/presets"
destination_default="$presets_directory/default.json"
staging_directory="$state_directory/.provisioning"
race_hook=${OCTESSERA_PROVISION_BEFORE_MOVE_HOOK:-}

[ "$(id -u)" = 0 ] || { echo "musical default provisioning requires root" >&2; exit 1; }
if [ ! -f "$source_default" ] || [ -L "$source_default" ]; then
  echo "packaged Pi default is missing or unsafe: $source_default" >&2
  exit 1
fi

identity_file() {
  if [ -n "$root_prefix" ]; then
    printf '%s\n' "$root_prefix/etc/$1"
  else
    printf '%s\n' "/etc/$1"
  fi
}

runtime_passwd_file=$(identity_file passwd)
runtime_group_file=$(identity_file group)
if [ ! -f "$runtime_passwd_file" ] || [ -L "$runtime_passwd_file" ]; then
  echo "runtime passwd file is missing or unsafe: $runtime_passwd_file" >&2
  exit 1
fi
if [ ! -f "$runtime_group_file" ] || [ -L "$runtime_group_file" ]; then
  echo "runtime group file is missing or unsafe: $runtime_group_file" >&2
  exit 1
fi
runtime_passwd=$(awk -F: '$1 == "octessera-runtime" { count++; row = $0 } END { if (count == 1) print row; else exit 1 }' "$runtime_passwd_file") || { echo "octessera-runtime account is not unique." >&2; exit 1; }
runtime_group=$(awk -F: '$1 == "octessera-runtime" { count++; row = $0 } END { if (count == 1) print row; else exit 1 }' "$runtime_group_file") || { echo "octessera-runtime group is not unique." >&2; exit 1; }
IFS=: read -r runtime_name _ runtime_uid runtime_gid _ _ _ <<EOF
$runtime_passwd
EOF
IFS=: read -r runtime_group_name _ runtime_group_gid _ <<EOF
$runtime_group
EOF
case "$runtime_uid" in ''|*[!0-9]*) echo "octessera-runtime identity is invalid." >&2; exit 1 ;; esac
case "$runtime_gid" in ''|*[!0-9]*) echo "octessera-runtime identity is invalid." >&2; exit 1 ;; esac
if [ "$runtime_name" != octessera-runtime ] || [ "$runtime_group_name" != octessera-runtime ] || [ "$runtime_gid" != "$runtime_group_gid" ] || [ "$runtime_uid" -eq 0 ] || [ "$runtime_gid" -eq 0 ] || [ "$runtime_uid" -ge 1000 ]; then
  echo "octessera-runtime identity is invalid." >&2
  exit 1
fi

install_root() {
  install -o root -g root "$@"
}

install_runtime() {
  install -o "$runtime_uid" -g "$runtime_gid" "$@"
}

require_directory() {
  path=$1
  owner=$2
  group=$3
  mode=$4
  if [ -L "$path" ] || [ ! -d "$path" ]; then
    echo "required directory is unsafe: $path" >&2
    exit 1
  fi
  [ "$(stat -c '%u:%g:%a' "$path")" = "$owner:$group:$mode" ] || { echo "required directory ownership or mode is unsafe: $path" >&2; exit 1; }
}

ensure_directory() {
  path=$1
  owner=$2
  group=$3
  mode=$4
  if [ -e "$path" ] || [ -L "$path" ]; then
    require_directory "$path" "$owner" "$group" "$mode"
  else
    if [ "$owner:$group" = "$runtime_uid:$runtime_gid" ]; then
      install_runtime -d -m "$mode" "$path"
    else
      install_root -d -m "$mode" "$path"
    fi
    require_directory "$path" "$owner" "$group" "$mode"
  fi
}

ensure_directory "$state_directory" 0 0 755
ensure_directory "$presets_directory" "$runtime_uid" "$runtime_gid" 755

validate_default() {
  path=$1
  if [ ! -f "$path" ] || [ -L "$path" ]; then
    echo "default destination is not a regular file: $path" >&2
    exit 1
  fi
  [ "$(stat -c '%u:%g:%a' "$path")" = "$runtime_uid:$runtime_gid:644" ] || { echo "default destination ownership or mode is unsafe: $path" >&2; exit 1; }
}

if [ -e "$destination_default" ] || [ -L "$destination_default" ]; then
  validate_default "$destination_default"
  exit 0
fi

if [ -n "$race_hook" ]; then
  [ -n "$root_prefix" ] || { echo "provision race hook is only allowed for rooted fixtures" >&2; exit 1; }
  if [ ! -x "$race_hook" ] || [ -L "$race_hook" ]; then
    echo "provision race hook is unsafe: $race_hook" >&2
    exit 1
  fi
fi

if [ -e "$staging_directory" ] || [ -L "$staging_directory" ]; then
  require_directory "$staging_directory" 0 0 700
else
  install_root -d -m 0700 "$staging_directory"
  require_directory "$staging_directory" 0 0 700
fi
if find -P "$staging_directory" -mindepth 1 -print -quit | grep -q .; then
  echo "provision staging directory is not empty: $staging_directory" >&2
  exit 1
fi

temporary=$(mktemp "$staging_directory/default.XXXXXX")
cleanup() {
  rm -f -- "$temporary"
  rmdir -- "$staging_directory" 2>/dev/null || true
}
trap cleanup EXIT
install_runtime -m 0644 "$source_default" "$temporary"

if [ -n "$race_hook" ]; then
  "$race_hook" "$destination_default"
fi

move_status=0
mv -T -n -- "$temporary" "$destination_default" || move_status=$?
if [ "$move_status" != 0 ] && [ ! -e "$destination_default" ] && [ ! -L "$destination_default" ]; then
  echo "default destination move failed: $destination_default" >&2
  exit "$move_status"
fi
validate_default "$destination_default"
