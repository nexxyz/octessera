#!/bin/sh
set -eu

root_prefix=${OCTESSERA_PROVISION_ROOT:-}
source_system="${root_prefix}/usr/share/octessera/defaults/pi-system.json"
source_patch="${root_prefix}/usr/share/octessera/defaults/pi-default.patch.json"
state_directory="${root_prefix}/var/lib/octessera"
presets_directory="$state_directory/presets"
destination_system="$presets_directory/system.json"
destination_patch="$presets_directory/default.patch.json"
legacy_default="$presets_directory/default.json"
staging_directory="$state_directory/.provisioning"

[ "$(id -u)" = 0 ] || { echo "musical default provisioning requires root" >&2; exit 1; }
for source in "$source_system" "$source_patch"; do
  if [ ! -f "$source" ] || [ -L "$source" ]; then
    echo "packaged Pi save document is missing or unsafe: $source" >&2
    exit 1
  fi
done

identity_file() {
  if [ -n "$root_prefix" ]; then
    printf '%s\n' "$root_prefix/etc/$1"
  else
    printf '%s\n' "/etc/$1"
  fi
}

runtime_passwd_file=$(identity_file passwd)
runtime_group_file=$(identity_file group)
if [ ! -f "$runtime_passwd_file" ] || [ -L "$runtime_passwd_file" ]; then
  echo "runtime passwd file is missing or unsafe: $runtime_passwd_file" >&2
  exit 1
fi
if [ ! -f "$runtime_group_file" ] || [ -L "$runtime_group_file" ]; then
  echo "runtime group file is missing or unsafe: $runtime_group_file" >&2
  exit 1
fi
runtime_passwd=$(awk -F: '$1 == "octessera-runtime" { count++; row = $0 } END { if (count == 1) print row; else exit 1 }' "$runtime_passwd_file") || { echo "octessera-runtime account is not unique." >&2; exit 1; }
runtime_group=$(awk -F: '$1 == "octessera-runtime" { count++; row = $0 } END { if (count == 1) print row; else exit 1 }' "$runtime_group_file") || { echo "octessera-runtime group is not unique." >&2; exit 1; }
IFS=: read -r runtime_name _ runtime_uid runtime_gid _ _ _ <<EOF
$runtime_passwd
EOF
IFS=: read -r runtime_group_name _ runtime_group_gid _ <<EOF
$runtime_group
EOF
case "$runtime_uid" in ''|*[!0-9]*) echo "octessera-runtime identity is invalid." >&2; exit 1 ;; esac
case "$runtime_gid" in ''|*[!0-9]*) echo "octessera-runtime identity is invalid." >&2; exit 1 ;; esac
if [ "$runtime_name" != octessera-runtime ] || [ "$runtime_group_name" != octessera-runtime ] || [ "$runtime_gid" != "$runtime_group_gid" ] || [ "$runtime_uid" -eq 0 ] || [ "$runtime_gid" -eq 0 ] || [ "$runtime_uid" -ge 1000 ]; then
  echo "octessera-runtime identity is invalid." >&2
  exit 1
fi

install_root() {
  install -o root -g root "$@"
}

install_runtime() {
  install -o "$runtime_uid" -g "$runtime_gid" "$@"
}

require_directory() {
  path=$1
  owner=$2
  group=$3
  mode=$4
  if [ -L "$path" ] || [ ! -d "$path" ]; then
    echo "required directory is unsafe: $path" >&2
    exit 1
  fi
  [ "$(stat -c '%u:%g:%a' "$path")" = "$owner:$group:$mode" ] || { echo "required directory ownership or mode is unsafe: $path" >&2; exit 1; }
}

ensure_directory() {
  path=$1
  owner=$2
  group=$3
  mode=$4
  if [ -e "$path" ] || [ -L "$path" ]; then
    require_directory "$path" "$owner" "$group" "$mode"
  else
    if [ "$owner:$group" = "$runtime_uid:$runtime_gid" ]; then
      install_runtime -d -m "$mode" "$path"
    else
      install_root -d -m "$mode" "$path"
    fi
    require_directory "$path" "$owner" "$group" "$mode"
  fi
}

ensure_directory "$state_directory" 0 0 755
ensure_directory "$presets_directory" "$runtime_uid" "$runtime_gid" 755

validate_document() {
  path=$1
  if [ ! -f "$path" ] || [ -L "$path" ]; then
    echo "save document is not a regular file: $path" >&2
    exit 1
  fi
  [ "$(stat -c '%u:%g:%a' "$path")" = "$runtime_uid:$runtime_gid:644" ] || { echo "save document ownership or mode is unsafe: $path" >&2; exit 1; }
}

validate_pair() {
  system_path=$1
  patch_path=$2
  python3 "$root_prefix/usr/local/lib/octessera/device_config.py" --data-role "$system_path" >/dev/null
  python3 - "$patch_path" <<'PY'
import json
import sys

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result

with open(sys.argv[1], encoding="utf-8") as handle:
    document = json.load(handle, object_pairs_hook=unique_object)
if (not isinstance(document, dict)
        or document.get("kind") != "octessera.patch"
        or type(document.get("schemaVersion")) is not int
        or document.get("schemaVersion") != 2
        or not isinstance(document.get("runtimeConfig"), dict)):
    raise SystemExit("default patch document v2 is invalid")
PY
}

if [ -e "$legacy_default" ] || [ -L "$legacy_default" ]; then
  echo "legacy mixed default exists; refusing to seed split save documents." >&2
  exit 1
fi
has_system=0
has_patch=0
[ ! -e "$destination_system" ] && [ ! -L "$destination_system" ] || has_system=1
[ ! -e "$destination_patch" ] && [ ! -L "$destination_patch" ] || has_patch=1
if [ "$has_system" -ne "$has_patch" ]; then
  echo "incomplete split save-document store; refusing to seed." >&2
  exit 1
fi
if [ "$has_system" -eq 1 ]; then
  validate_document "$destination_system"
  validate_document "$destination_patch"
  validate_pair "$destination_system" "$destination_patch"
  exit 0
fi

if [ -e "$staging_directory" ] || [ -L "$staging_directory" ]; then
  require_directory "$staging_directory" 0 0 700
else
  install_root -d -m 0700 "$staging_directory"
  require_directory "$staging_directory" 0 0 700
fi
if find -P "$staging_directory" -mindepth 1 -print -quit | grep -q .; then
  echo "provision staging directory is not empty: $staging_directory" >&2
  exit 1
fi

temporary_system=$(mktemp "$staging_directory/system.XXXXXX")
temporary_patch=$(mktemp "$staging_directory/patch.XXXXXX")
cleanup() {
  rm -f -- "$temporary_system" "$temporary_patch"
  rmdir -- "$staging_directory" 2>/dev/null || true
}
trap cleanup EXIT
install_runtime -m 0644 "$source_system" "$temporary_system"
install_runtime -m 0644 "$source_patch" "$temporary_patch"
validate_pair "$temporary_system" "$temporary_patch"

for pair in "$temporary_system:$destination_system" "$temporary_patch:$destination_patch"; do
  temporary=${pair%%:*}
  destination=${pair#*:}
  mv -T -n -- "$temporary" "$destination"
  validate_document "$destination"
done
