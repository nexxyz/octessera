{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "octessera",
  "version": "0.8.0",
  "identifier": "xyz.nex.octessera",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm --dir ../.. run assets:generate && python ../../tools/samples/sample_library.py --repository-root ../.. --media-destination ../../release-samples/samples --manifest-destination ../../release-samples/sample-manifest.tsv && corepack pnpm --dir ../.. run legal:stage-desktop && vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "octessera",
        "width": 1015,
        "height": 675,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../../../release-legal/usr/share/doc/octessera": "legal",
      "../../../resources/legal/notice-bundle.json": "legal/notice-bundle.json",
      "../../../release-samples/samples": "samples"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
