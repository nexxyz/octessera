diff --git a/lib/functions/compilation/kernel-debs.sh b/lib/functions/compilation/kernel-debs.sh
--- a/lib/functions/compilation/kernel-debs.sh
+++ b/lib/functions/compilation/kernel-debs.sh
@@ -40,3 +40,18 @@
 }
 
+function ahub_normalize_kernel_package_inputs() {
+	local install_path="${tmp_kernel_install_dirs[INSTALL_PATH]}"
+	local expected_path dirty_path stem
+	for stem in vmlinuz config System.map; do
+		expected_path="${install_path}/${stem}-${kernel_version_family}"
+		dirty_path="${expected_path}-dirty"
+		if [[ -e "${dirty_path}" && ! -e "${expected_path}" ]]; then
+			mv -- "${dirty_path}" "${expected_path}"
+		elif [[ -e "${dirty_path}" ]]; then
+			printf '%s\n' "AHUB package input collision: ${dirty_path} and ${expected_path}" >&2
+			return 1
+		fi
+	done
+}
+
 function prepare_kernel_packaging_debs() {
@@ -69,5 +84,6 @@
 	if [[ "${KERNEL_DTB_ONLY}" != "yes" ]]; then
 		# package the linux-image (image, modules, dtbs (if present))
 		display_alert "Packaging linux-image" "${LINUXFAMILY} ${LINUXCONFIG}" "info"
+		ahub_normalize_kernel_package_inputs
 		create_kernel_deb "linux-image-${BRANCH}-${LINUXFAMILY}" "${debs_target_dir}" kernel_package_callback_linux_image "linux-image"
 	fi
