#!/usr/bin/env python3
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
import zipfile
from pathlib import Path

REPO = "nexxyz/octessera"
API = os.environ.get("OCTESSERA_UPDATE_API", f"https://api.github.com/repos/{REPO}/releases?per_page=30")
DOWNLOADS = os.environ.get("OCTESSERA_UPDATE_DOWNLOADS", f"https://github.com/{REPO}/releases/download")
ROOT = Path(os.environ.get("OCTESSERA_UPDATE_ROOT", "/opt/octessera"))
PROFILE_FILES = [Path(os.environ["OCTESSERA_UPDATE_PROFILE_FILE"])] if os.environ.get("OCTESSERA_UPDATE_PROFILE_FILE") else [
    Path("/etc/octessera/board-profile.env"),
    Path("/etc/octessera/build-metadata.env"),
]
MARKER = Path(os.environ.get("OCTESSERA_CANDIDATE_HEALTH_PATH", "/run/octessera/candidate-ready.json"))
DEV_DROP_IN = Path(os.environ.get("OCTESSERA_UPDATE_DEV_DROP_IN", "/etc/systemd/system/octessera.service.d/90-octessera-dev.conf"))
SYSTEMCTL = os.environ.get("OCTESSERA_UPDATE_SYSTEMCTL", "systemctl")
READY_SECONDS = float(os.environ.get("OCTESSERA_UPDATE_READY_SECONDS", "60"))
SETTLE_SECONDS = float(os.environ.get("OCTESSERA_UPDATE_SETTLE_SECONDS", "5"))
SERVICE = "octessera.service"
PROFILES = ("raspberry-pi-zero-2w", "orange-pi-zero-2w")
BINARY = "octessera-pi"
ENTRIES = sorted([BINARY, "octessera-runtime.json", "SHA256SUMS", "LICENSE", "NOTICE"])
VERSION_RE = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+")
MAX_JSON_BYTES = 4 * 1024 * 1024
MAX_ZIP_BYTES = 128 * 1024 * 1024
MAX_SUMS_BYTES = 64 * 1024
MAX_MESSAGE_BYTES = 512


class UpdateError(Exception):
    pass


def board_profile() -> str:
    for path in PROFILE_FILES:
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            if line.startswith("OCTESSERA_BOARD_PROFILE_ID="):
                profile = line.split("=", 1)[1].strip()
                if profile in PROFILES:
                    return profile
    raise UpdateError("Board profile is unknown; reflash this device")


def asset_names(profile: str, version: str) -> tuple[str, str]:
    return f"octessera-{version}-{profile}-device-aarch64.zip", f"SHA256SUMS-{profile}-device.txt"


def version_key(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in version.split("."))


def open_url(url: str):
    request = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "octessera-update"})
    try:
        return urllib.request.urlopen(request, timeout=30)
    except (OSError, ValueError) as error:
        raise UpdateError(f"Download failed: {url.rsplit('/', 1)[-1]}") from error


def fetch(url: str, limit: int) -> bytes:
    with open_url(url) as response:
        data = response.read(limit + 1)
    if len(data) > limit:
        raise UpdateError(f"Download is too large: {url.rsplit('/', 1)[-1]}")
    return data


def download(url: str, path: Path, limit: int) -> str:
    digest = hashlib.sha256()
    size = 0
    with open_url(url) as response, path.open("wb") as output:
        while chunk := response.read(1024 * 1024):
            size += len(chunk)
            if size > limit:
                raise UpdateError(f"Download is too large: {path.name}")
            digest.update(chunk)
            output.write(chunk)
    return digest.hexdigest()


def newest_release(profile: str) -> str | None:
    try:
        releases = json.loads(fetch(API, MAX_JSON_BYTES))
    except ValueError as error:
        raise UpdateError("Release list is not valid JSON") from error
    versions = []
    for release in releases if isinstance(releases, list) else []:
        if not isinstance(release, dict) or release.get("draft") or release.get("prerelease"):
            continue
        tag = release.get("tag_name")
        if not isinstance(tag, str) or not tag.startswith("v") or not VERSION_RE.fullmatch(tag[1:]):
            continue
        names = {asset.get("name") for asset in release.get("assets") or [] if isinstance(asset, dict)}
        if set(asset_names(profile, tag[1:])) <= names:
            versions.append(tag[1:])
    return max(versions, key=version_key, default=None)


def current_version() -> str:
    try:
        return Path(os.readlink(ROOT / "current")).name
    except OSError as error:
        raise UpdateError("No current release is installed; reflash this device") from error


def is_newer(candidate: str, current: str) -> bool:
    return not VERSION_RE.fullmatch(current) or version_key(candidate) > version_key(current)


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def extract(archive: Path, output: Path) -> None:
    try:
        with zipfile.ZipFile(archive) as source:
            infos = source.infolist()
            if sorted(info.filename for info in infos) != ENTRIES:
                raise UpdateError("Release archive has unexpected contents")
            if sum(info.file_size for info in infos) > MAX_ZIP_BYTES:
                raise UpdateError("Release archive is too large")
            output.mkdir()
            os.chmod(output, 0o755)
            for info in infos:
                target = output / info.filename
                with source.open(info) as data, target.open("wb") as handle:
                    shutil.copyfileobj(data, handle)
                    handle.flush()
                    os.fsync(handle.fileno())
                os.chmod(target, 0o755 if info.filename == BINARY else 0o644)
    except zipfile.BadZipFile as error:
        raise UpdateError("Release archive is not a valid ZIP") from error
    fsync_directory(output)


def stage(profile: str, version: str) -> None:
    archive_name, sums_name = asset_names(profile, version)
    releases = ROOT / "releases"
    releases.mkdir(parents=True, exist_ok=True)
    work = releases / f".tmp-{version}"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir()
    try:
        digest = download(f"{DOWNLOADS}/v{version}/{archive_name}", work / archive_name, MAX_ZIP_BYTES)
        sums = fetch(f"{DOWNLOADS}/v{version}/{sums_name}", MAX_SUMS_BYTES).decode("utf-8", "replace")
        expected = [fields[0].lower() for fields in map(str.split, sums.splitlines()) if len(fields) == 2 and fields[1].lstrip("*") == archive_name]
        if expected != [digest]:
            raise UpdateError("Checksum does not match; nothing was changed")
        extract(work / archive_name, work / "release")
        final = releases / version
        shutil.rmtree(final, ignore_errors=True)
        os.rename(work / "release", final)
        fsync_directory(releases)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def systemctl(*arguments: str) -> int:
    try:
        return subprocess.run([SYSTEMCTL, *arguments], timeout=60, capture_output=True).returncode
    except (OSError, subprocess.TimeoutExpired) as error:
        raise UpdateError(f"systemctl {arguments[0]} failed") from error


def start_switch(version: str) -> None:
    if systemctl("start", "--no-block", f"octessera-update-switch@{version}.service") != 0:
        raise UpdateError("Could not start the release switch")


def replace_link(path: Path, target: str | None) -> None:
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.unlink(missing_ok=True)
    if target is None:
        path.unlink(missing_ok=True)
        return
    os.symlink(target, temporary)
    os.replace(temporary, path)


def set_links(current: str, previous: str | None) -> None:
    replace_link(ROOT / "previous", previous)
    replace_link(ROOT / "current", current)
    fsync_directory(ROOT)


def restart_and_wait() -> bool:
    MARKER.unlink(missing_ok=True)
    systemctl("restart", SERVICE)
    deadline = time.monotonic() + READY_SECONDS
    while time.monotonic() < deadline:
        if MARKER.exists() and systemctl("is-active", "--quiet", SERVICE) == 0:
            time.sleep(SETTLE_SECONDS)
            return MARKER.exists() and systemctl("is-active", "--quiet", SERVICE) == 0
        time.sleep(0.5)
    return False


def prune(keep: set[str]) -> None:
    for child in (ROOT / "releases").iterdir():
        if child.name not in keep and VERSION_RE.fullmatch(child.name) and not child.is_symlink():
            shutil.rmtree(child, ignore_errors=True)


def lock(wait: bool):
    handle = (ROOT / ".update.lock").open("a")
    deadline = time.monotonic() + (10 if wait else 0)
    while True:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if time.monotonic() >= deadline:
                handle.close()
                raise UpdateError("Another update is running")
            time.sleep(0.2)


def check() -> str:
    current = current_version()
    available = newest_release(board_profile())
    if available is None:
        return f"No release for this board yet (installed v{current})"
    if is_newer(available, current):
        return f"v{available} available (installed v{current})"
    return f"Up to date (v{current})"


def require_release_service() -> None:
    if DEV_DROP_IN.exists():
        raise UpdateError("A development build is running; restore the release service first")


def apply() -> str:
    profile = board_profile()
    require_release_service()
    with lock(wait=False):
        current = current_version()
        available = newest_release(profile)
        if available is None or not is_newer(available, current):
            return f"Up to date (v{current})"
        stage(profile, available)
        start_switch(available)
    return f"Installing v{available}; Octessera restarts in a moment"


def rollback() -> str:
    require_release_service()
    with lock(wait=False):
        previous = ROOT / "previous"
        if not previous.is_symlink() or not (previous / BINARY).is_file():
            raise UpdateError("No previous release to go back to")
        version = Path(os.readlink(previous)).name
        start_switch(version)
    return f"Going back to v{version}; Octessera restarts in a moment"


def switch(version: str) -> str:
    if not VERSION_RE.fullmatch(version):
        raise UpdateError("Invalid release version")
    with lock(wait=True):
        target = ROOT / "releases" / version
        if not (target / BINARY).is_file():
            raise UpdateError(f"Release v{version} is not installed")
        old_current = os.readlink(ROOT / "current")
        old_previous = os.readlink(ROOT / "previous") if (ROOT / "previous").is_symlink() else None
        old_version = Path(old_current).name
        if old_version == version:
            raise UpdateError(f"v{version} is already current")
        set_links(str(target), old_current)
        if restart_and_wait():
            prune({version, old_version})
            return f"Now running v{version}"
        set_links(old_current, old_previous)
        systemctl("restart", SERVICE)
        raise UpdateError(f"v{version} did not start; went back to v{old_version}")


ACTIONS = {"check": check, "apply": apply, "rollback": rollback}


def run(argv: list[str]) -> tuple[bool, str]:
    try:
        if len(argv) == 1 and argv[0] in ACTIONS:
            return True, ACTIONS[argv[0]]()
        if len(argv) == 2 and argv[0] == "switch":
            return True, switch(argv[1])
        return False, "Usage: octessera-update check | apply | rollback"
    except UpdateError as error:
        return False, str(error)
    except Exception as error:
        return False, f"Update failed: {error}"


def serve() -> int:
    action = sys.stdin.buffer.readline(64).decode("ascii", "replace").strip()
    ok, message = run([action]) if action in ACTIONS else (False, "Invalid update request")
    sys.stdout.buffer.write((b"ok\n" if ok else b"error\n") + message.encode("utf-8")[:MAX_MESSAGE_BYTES])
    sys.stdout.flush()
    return 0 if ok else 1


def main(argv: list[str]) -> int:
    if argv == ["serve"]:
        return serve()
    ok, message = run(argv)
    print(message, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
