#!/usr/bin/env python3
import os
import select
import subprocess
import sys


UPDATE_PATH = "/usr/local/sbin/octessera-update"
CHECK_REQUEST = b"check\n"
APPLY_REQUEST = b"apply\n"
ROLLBACK_REQUEST = b"rollback\n"
OK_RESPONSE = b"ok\n"
ERROR_RESPONSE = b"error\n"
MAX_REQUEST_BYTES = 64
MAX_OUTPUT_BYTES = 512
EXTRA_BYTE_WAIT_SECONDS = 0.1
UPDATE_TIMEOUT_SECONDS = 170


def _extra_bytes(stream):
    try:
        descriptor = stream.fileno()
    except (AttributeError, OSError):
        return stream.read(1)
    readable, _, _ = select.select([descriptor], [], [], EXTRA_BYTE_WAIT_SECONDS)
    return stream.read(1) if readable else b""


def _read_request(stream):
    try:
        descriptor = stream.fileno()
    except (AttributeError, OSError):
        line = stream.readline(MAX_REQUEST_BYTES + 1)
        extra = stream.read(1)
    else:
        data = bytearray()
        while len(data) <= MAX_REQUEST_BYTES:
            readable, _, _ = select.select([descriptor], [], [], EXTRA_BYTE_WAIT_SECONDS)
            if not readable:
                break
            chunk = os.read(descriptor, 1)
            if not chunk:
                break
            data.extend(chunk)
            if chunk == b"\n":
                break
        line = bytes(data)
        extra = _extra_bytes(stream)
    if line not in (CHECK_REQUEST, APPLY_REQUEST, ROLLBACK_REQUEST) or extra:
        raise ValueError("invalid update broker request")
    return line[:-1].decode("ascii")


def _bounded_output(value):
    text = value.decode("utf-8", errors="replace")
    text = "".join(" " if character.isspace() or not character.isprintable() else character for character in text)
    return text.strip().encode("utf-8")[:MAX_OUTPUT_BYTES]


def _write_response(stream, ok, stdout=b"", stderr=b""):
    selected = stdout if ok else stderr or stdout
    prefix = OK_RESPONSE if ok else ERROR_RESPONSE
    stream.write(prefix + _bounded_output(selected))
    stream.flush()


def handle_request(input_stream, output_stream):
    try:
        action = _read_request(input_stream)
    except (OSError, ValueError):
        _write_response(output_stream, False, stderr=b"invalid update broker request")
        raise
    try:
        result = subprocess.run(
            [UPDATE_PATH, action],
            check=False,
            capture_output=True,
            timeout=UPDATE_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.SubprocessError) as error:
        _write_response(output_stream, False, stderr=str(error).encode("utf-8"))
        raise
    ok = result.returncode == 0
    _write_response(output_stream, ok, result.stdout, result.stderr)
    return ok


def main():
    if os.geteuid() != 0:
        return 1
    try:
        return 0 if handle_request(sys.stdin.buffer, sys.stdout.buffer) else 1
    except (OSError, ValueError, subprocess.SubprocessError):
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
