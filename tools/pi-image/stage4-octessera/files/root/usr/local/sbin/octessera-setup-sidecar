#!/usr/bin/env python3
import base64
import binascii
import hashlib
import hmac
import http.server
import ipaddress
import json
import os
import re
import socket
import stat
import struct
import subprocess
import threading


MAX_BODY = 16384
NONCE_PATH = "/run/octessera-setup/nonce"
READINESS_PATH = "/run/octessera-setup/readiness"
USER = "pi"
HOME = f"/home/{USER}"
MARKER = "/var/lib/octessera/setup-complete"
KEY_PATH = f"{HOME}/.ssh/authorized_keys"
ALLOWED_ORIGINS = frozenset(("http://192.168.42.1", "http://192.168.42.1:80"))
SETUP_CLIENT_NET = ipaddress.ip_network("192.168.42.0/24")
ALLOWED_FIELDS = frozenset(("sshMode", "sshPublicKey", "sshPassword", "sshPasswordConfirm", "hostname", "wifiCountry"))
KEY_TYPES = frozenset(("ssh-ed25519", "ssh-rsa", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521"))
KEY_LINE = re.compile(r"^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(?:256|384|521)) ([A-Za-z0-9+/]+={0,2})(?: ([ -~]{1,256}))?$")
HOSTNAME_LABEL = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$")
staged = {}
stage_lock = threading.RLock()


def valid_hostname(value):
    return isinstance(value, str) and (value == "" or (len(value) <= 253 and all(len(label) <= 63 and bool(HOSTNAME_LABEL.fullmatch(label)) for label in value.split("."))))


def valid_country(value):
    return isinstance(value, str) and (value == "" or bool(re.fullmatch(r"[A-Z]{2}", value)))


def _has_control(value):
    return any(ord(character) < 32 or ord(character) == 127 for character in value)


def valid_public_key(value):
    if not isinstance(value, str) or len(value) > 4096 or "\n" in value or "\r" in value or _has_control(value):
        return False
    match = KEY_LINE.fullmatch(value)
    if match is None:
        return False
    key_type, encoded = match.group(1), match.group(2)
    if key_type not in KEY_TYPES or len(encoded) % 4 != 0:
        return False
    try:
        decoded = base64.b64decode(encoded, validate=True)
    except (ValueError, binascii.Error):
        return False
    if not 32 <= len(decoded) <= 4096 or len(decoded) < 4:
        return False
    type_length = struct.unpack(">I", decoded[:4])[0]
    return type_length == len(key_type) and decoded[4 : 4 + type_length] == key_type.encode("ascii")


def valid_password(value):
    return isinstance(value, str) and 12 <= len(value) <= 128 and bool(value.strip()) and not _has_control(value)


def validate_stage(data):
    if not isinstance(data, dict) or frozenset(data) != ALLOWED_FIELDS:
        raise ValueError("invalid stage")
    if any(not isinstance(data[field], str) for field in ALLOWED_FIELDS):
        raise ValueError("invalid stage")
    mode = data["sshMode"]
    hostname = data["hostname"].strip() if isinstance(data["hostname"], str) else ""
    country = data["wifiCountry"].strip().upper() if isinstance(data["wifiCountry"], str) else ""
    if mode not in ("none", "key", "password") or not isinstance(data["hostname"], str) or _has_control(data["hostname"]):
        raise ValueError("invalid stage")
    if not valid_hostname(hostname) or not valid_country(country):
        raise ValueError("invalid stage")
    result = {"sshMode": mode, "hostname": hostname, "country": country}
    if mode == "key":
        if not valid_public_key(data["sshPublicKey"]) or data["sshPassword"] or data["sshPasswordConfirm"]:
            raise ValueError("invalid stage")
        result["sshKey"] = data["sshPublicKey"]
    elif mode == "password":
        password = data["sshPassword"]
        if data["sshPublicKey"] or data["sshPasswordConfirm"] != password or not valid_password(password):
            raise ValueError("invalid stage")
        result["password"] = password
    elif any(data[field] for field in ("sshPublicKey", "sshPassword", "sshPasswordConfirm")):
        raise ValueError("invalid stage")
    return result


def run(args, input_text=None):
    subprocess.run(args, input=input_text, text=True, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _write_atomic(path, content, mode, owner=0, group=0):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    temporary = f"{path}.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, owner, group)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = -1
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        os.chmod(path, mode)
        os.chown(path, owner, group)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def configure_key(key):
    ssh_dir = f"{HOME}/.ssh"
    if os.path.lexists(ssh_dir):
        metadata = os.lstat(ssh_dir)
        if not stat.S_ISDIR(metadata.st_mode):
            raise OSError("unsafe ssh directory")
    else:
        os.mkdir(ssh_dir, 0o700)
    import pwd

    account = pwd.getpwnam(USER)
    os.chown(ssh_dir, account.pw_uid, account.pw_gid)
    os.chmod(ssh_dir, 0o700)
    _write_atomic(KEY_PATH, key + "\n", 0o600, account.pw_uid, account.pw_gid)


def remove_key():
    try:
        os.unlink(KEY_PATH)
    except FileNotFoundError:
        pass


def set_password_auth(enabled):
    value = "yes" if enabled else "no"
    _write_atomic("/etc/ssh/sshd_config.d/10-octessera-setup.conf", f"PermitRootLogin no\nPasswordAuthentication {value}\nAllowUsers {USER}\n", 0o644)


def set_country(country):
    if not country:
        return
    try:
        run(["iw", "reg", "set", country])
    except subprocess.CalledProcessError:
        pass
    _write_atomic("/etc/modprobe.d/octessera-regdom.conf", f"options cfg80211 ieee80211_regdom={country}\n", 0o644)
    if os.path.exists("/etc/default/crda"):
        _write_atomic("/etc/default/crda", f"REGDOMAIN={country}\n", 0o644)


def finalize():
    with stage_lock:
        if not staged:
            raise ValueError("stage_missing")
        data = dict(staged)
    try:
        if data["hostname"]:
            run(["hostnamectl", "set-hostname", data["hostname"]])
        set_country(data["country"])
        mode = data["sshMode"]
        if mode == "key":
            configure_key(data["sshKey"])
            set_password_auth(False)
        elif mode == "password":
            remove_key()
            run(["chpasswd"], f"{USER}:{data['password']}\n")
            set_password_auth(True)
        else:
            remove_key()
            run(["passwd", "-l", USER])
            set_password_auth(False)
            run(["systemctl", "disable", "--now", "ssh.service"])
            run(["systemctl", "mask", "ssh.service"])
        if mode in ("key", "password"):
            run(["ssh-keygen", "-A"])
            run(["systemctl", "unmask", "ssh.service"])
            run(["systemctl", "enable", "--now", "ssh.service"])
        _write_atomic(MARKER, "complete\n", 0o644)
    finally:
        with stage_lock:
            staged.clear()


def _one_header(handler, name):
    values = handler.headers.get_all(name, [])
    return values[0] if len(values) == 1 else None


def origin_allowed(handler):
    return _one_header(handler, "Origin") in ALLOWED_ORIGINS


def setup_client_allowed(handler):
    try:
        return ipaddress.ip_address(handler.client_address[0]) in SETUP_CLIENT_NET
    except ValueError:
        return False


def _body(handler):
    if handler.headers.get_all("Transfer-Encoding", []):
        return None, 400
    value = _one_header(handler, "Content-Length")
    if value is None or len(value) > 5 or not re.fullmatch(r"[1-9][0-9]*", value):
        return None, 400
    length = int(value)
    if not 1 <= length <= MAX_BODY:
        return None, 413 if length > MAX_BODY else 400
    body = handler.rfile.read(length)
    return (body, 200) if len(body) == length else (None, 400)


def _consume_nonce(handler):
    if handler.client_address[0] not in ("127.0.0.1", "::1"):
        return False
    nonce_header = _one_header(handler, "X-Octessera-Setup-Nonce")
    if nonce_header is None:
        return False
    try:
        metadata = os.lstat(NONCE_PATH)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1:
            return False
        with open(NONCE_PATH, "rb") as handle:
            nonce = handle.read(129)
        if not 32 <= len(nonce) <= 128 or not hmac.compare_digest(nonce_header.encode("ascii"), nonce):
            return False
        os.unlink(NONCE_PATH)
        return True
    except (OSError, UnicodeError):
        return False


def _publish_readiness():
    runtime_metadata = os.lstat(os.path.dirname(READINESS_PATH))
    if not stat.S_ISDIR(runtime_metadata.st_mode) or runtime_metadata.st_uid != 0 or stat.S_IMODE(runtime_metadata.st_mode) != 0o700:
        raise OSError("unsafe setup runtime directory")
    nonce_metadata = os.lstat(NONCE_PATH)
    if not stat.S_ISREG(nonce_metadata.st_mode) or nonce_metadata.st_uid != 0 or stat.S_IMODE(nonce_metadata.st_mode) != 0o600 or nonce_metadata.st_nlink != 1:
        raise OSError("unsafe setup nonce")
    with open(NONCE_PATH, "rb") as handle:
        nonce = handle.read(129)
    if not 32 <= len(nonce) <= 128 or any(byte in b"\r\n\x00" for byte in nonce):
        raise OSError("invalid setup nonce")
    readiness = hashlib.sha256(nonce + b":octessera-setup-ready").hexdigest().encode("ascii") + b"\n"
    temporary = f"{READINESS_PATH}.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.fchown(descriptor, 0, 0)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(readiness)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, READINESS_PATH)
        os.chown(READINESS_PATH, 0, 0)
        os.chmod(READINESS_PATH, 0o600)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


class Handler(http.server.BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.connection.settimeout(10)

    def log_message(self, _format, *_args):
        return

    def send_json(self, code, payload):
        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        origin = _one_header(self, "Origin")
        if origin in ALLOWED_ORIGINS:
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        if not origin_allowed(self) or not setup_client_allowed(self):
            self.send_json(403, {"error": "forbidden"})
            return
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", _one_header(self, "Origin"))
        self.send_header("Access-Control-Allow-Methods", "POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Max-Age", "0")
        self.end_headers()

    def do_POST(self):
        try:
            body, body_status = _body(self)
        except (socket.timeout, TimeoutError):
            self.send_json(408, {"error": "timeout"})
            return
        if body_status != 200:
            self.send_json(body_status, {"error": "invalid_body"})
            return
        try:
            if self.path == "/stage":
                content_type = _one_header(self, "Content-Type")
                if content_type != "application/json" or not origin_allowed(self) or not setup_client_allowed(self):
                    self.send_json(403, {"error": "forbidden"})
                    return
                data = validate_stage(json.loads(body.decode("utf-8")))
                with stage_lock:
                    staged.clear()
                    staged.update(data)
                self.send_json(200, {"ok": True})
                return
            if self.path not in ("/finalize", "/discard") or not _consume_nonce(self):
                self.send_json(403, {"error": "forbidden"})
                return
            if self.path == "/discard":
                with stage_lock:
                    staged.clear()
                self.send_json(200, {"ok": True})
                return
            finalize()
            self.send_json(200, {"ok": True})
        except (ValueError, json.JSONDecodeError, UnicodeDecodeError):
            with stage_lock:
                staged.clear()
            self.send_json(400, {"error": "invalid_stage"})
        except (OSError, subprocess.CalledProcessError):
            with stage_lock:
                staged.clear()
            self.send_json(500, {"error": "finalize_failed"})


if __name__ == "__main__":
    server = http.server.HTTPServer(("0.0.0.0", 8080), Handler)
    _publish_readiness()
    server.serve_forever()
