#!/usr/bin/env bash
set -euo pipefail
# shellcheck disable=SC2317

marker=/var/lib/octessera/setup-complete
runtime_dir=/run/octessera-setup
nonce_path=$runtime_dir/nonce
readiness_path=$runtime_dir/readiness
ui_dir=/usr/local/share/octessera-setup-ui
status_tool=/usr/local/lib/octessera/setup-status.py
call_tool=/usr/local/lib/octessera/setup-call.py
interface=wlan0
sidecar_pid=
portal_suffix=

publish() {
    if [[ "$1" == portal_ready ]]; then
        python3 "$status_tool" update "$1" "$2" "$portal_suffix" >/dev/null 2>&1
    else
        python3 "$status_tool" update "$1" "$2" >/dev/null 2>&1
    fi
}

terminal() {
    python3 "$status_tool" terminal "$1" "$2" >/dev/null 2>&1 || true
}

# shellcheck disable=SC2317
cleanup() {
    if [[ -n "$sidecar_pid" ]]; then
        kill "$sidecar_pid" >/dev/null 2>&1 || true
        wait "$sidecar_pid" >/dev/null 2>&1 || true
    fi
    rm -f -- "$nonce_path" "$readiness_path"
}

# shellcheck disable=SC2317
interrupted() {
    terminal failed operation_failed
    exit 130
}

trap cleanup EXIT
trap interrupted INT TERM

has_active_connection() {
    nmcli -t -f DEVICE,STATE device status 2>/dev/null | grep -qx "$interface:connected"
}

has_configured_wifi() {
    nmcli -t -f TYPE connection show 2>/dev/null | grep -qx '802-11-wireless'
}

create_nonce() {
    python3 - "$nonce_path" <<'PY'
import os
import secrets
import sys

path = sys.argv[1]
descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
try:
    os.fchmod(descriptor, 0o600)
    os.fchown(descriptor, 0, 0)
    os.write(descriptor, secrets.token_urlsafe(48).encode("ascii"))
finally:
    os.close(descriptor)
PY
}

verify_readiness() {
    python3 - "$nonce_path" "$readiness_path" <<'PY'
import hashlib
import hmac
import os
import stat
import sys

nonce_path, readiness_path = sys.argv[1:]
try:
    nonce_metadata = os.lstat(nonce_path)
    readiness_metadata = os.lstat(readiness_path)
    if not stat.S_ISREG(nonce_metadata.st_mode) or nonce_metadata.st_uid != 0 or stat.S_IMODE(nonce_metadata.st_mode) != 0o600 or nonce_metadata.st_nlink != 1:
        raise SystemExit(1)
    if not stat.S_ISREG(readiness_metadata.st_mode) or readiness_metadata.st_uid != 0 or stat.S_IMODE(readiness_metadata.st_mode) != 0o600 or readiness_metadata.st_nlink != 1:
        raise SystemExit(1)
    with open(nonce_path, "rb") as handle:
        nonce = handle.read(129)
    with open(readiness_path, "rb") as handle:
        readiness = handle.read(66)
    expected = hashlib.sha256(nonce + b":octessera-setup-ready").hexdigest().encode("ascii") + b"\n"
    if len(nonce) < 32 or len(nonce) > 128 or len(readiness) != 65 or not hmac.compare_digest(readiness, expected):
        raise SystemExit(1)
except (OSError, ValueError):
    raise SystemExit(1)
PY
}

remaining_seconds() {
    python3 "$status_tool" remaining
}

if [[ ! -f "/sys/class/net/$interface/address" || -L "/sys/class/net/$interface/address" ]]; then
    terminal failed unavailable
    exit 1
fi
mac_address="$(cat "/sys/class/net/$interface/address")"
if [[ ! "$mac_address" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; then
    terminal failed unavailable
    exit 1
fi
portal_suffix="${mac_address,,}"
portal_suffix="${portal_suffix//:/}"
portal_suffix="${portal_suffix: -4}"

reentry="$(python3 "$status_tool" active-info)"
if [[ "$reentry" != 1 && -f "$marker" ]]; then
    terminal succeeded ''
    exit 0
fi
if [[ "$reentry" != 1 ]] && { has_active_connection || has_configured_wifi; }; then
    terminal succeeded ''
    exit 0
fi

python3 "$status_tool" bind-pid "$$" >/dev/null 2>&1
if [[ "$(remaining_seconds)" == 0.000 ]]; then
    terminal timed_out unavailable
    exit 0
fi
install -d -m 0700 "$runtime_dir"
create_nonce
/usr/local/sbin/octessera-setup-sidecar >/dev/null 2>&1 &
sidecar_pid=$!

ready=false
for _ in $(seq 1 50); do
    if verify_readiness; then
        ready=true
        break
    fi
    kill -0 "$sidecar_pid" >/dev/null 2>&1 || break
    sleep 0.1
done
if [[ "$ready" != true ]]; then
    terminal failed operation_failed
    exit 1
fi
publish portal_ready ''
remaining="$(remaining_seconds)"
if [[ "$remaining" == 0.000 ]]; then
    terminal timed_out unavailable
    exit 0
fi

set +e
timeout --foreground --signal=TERM --kill-after=5s "${remaining}s" \
    /usr/local/bin/wifi-connect \
    --portal-ssid "Octessera Setup $portal_suffix" \
    --portal-interface "$interface" \
    --portal-gateway 192.168.42.1 \
    --portal-listening-port 80 \
    --ui-directory "$ui_dir"
portal_result=$?
set -e

if [[ "$portal_result" -eq 0 ]]; then
    publish finalizing ''
    if python3 "$call_tool" finalize >/dev/null 2>&1; then
        terminal succeeded ''
        exit 0
    fi
    terminal failed operation_failed
    exit 1
fi

python3 "$call_tool" discard >/dev/null 2>&1 || true
if [[ "$portal_result" -eq 124 ]]; then
    terminal timed_out unavailable
else
    terminal failed operation_failed
fi
exit 0
