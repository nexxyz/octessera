[Unit]
Description=octessera OLED SD card mount
After=local-fs.target systemd-udev-trigger.service

[Service]
Type=oneshot
Environment=OCTESSERA_SD_MOUNT=/home/pi/samples/sd-card
Environment=OCTESSERA_SD_OWNER=pi
ExecStart=/usr/local/sbin/octessera-sd-card mount

[Install]
WantedBy=multi-user.target
