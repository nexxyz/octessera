[Unit]
Description=octessera Performance CPU Governor
Before=octessera.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do [ -e "$gov" ] || continue; printf performance > "$gov" || true; done'
# systemd itself starts services on CPU 1 otherwise; keep it off the audio core.
# init.scope has no persistent drop-ins, so this is set at every boot.
ExecStartPost=-/bin/systemctl set-property --runtime init.scope AllowedCPUs=2-3
# Unbound kernel workers (such as SD-card writeback) stay off the audio core too.
ExecStartPost=-/bin/sh -c 'printf d > /sys/devices/virtual/workqueue/cpumask'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
