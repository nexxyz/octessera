{
  "schema_version": 1,
  "strictness": {
    "unknown_keys": "reject",
    "missing_keys": "reject"
  },
  "coordinate_space": {
    "orientation": "physical_post_rotation",
    "width_px": 128,
    "height_px": 128,
    "x_direction": "rightward",
    "y_direction": "bottom_to_top"
  },
  "source_pixel_rule": {
    "pixel_format": "rgb565_hex",
    "recolor_match_rgb565": "FFFF",
    "match_action": "recolor",
    "non_match_action": "preserve"
  },
  "bands": {
    "order": "increasing_x_travel_axis",
    "band_count": 4,
    "band_width_px": 8,
    "train_width_px": 32,
    "items": [
      {
        "band_index": 0,
        "name": "cyan",
        "color_rgb565": "07FF",
        "width_px": 8
      },
      {
        "band_index": 1,
        "name": "yellow",
        "color_rgb565": "FFE0",
        "width_px": 8
      },
      {
        "band_index": 2,
        "name": "green",
        "color_rgb565": "07E0",
        "width_px": 8
      },
      {
        "band_index": 3,
        "name": "magenta",
        "color_rgb565": "F81F",
        "width_px": 8
      }
    ]
  },
  "slant": {
    "offset_formula": "floor(row_y * 8 / 127)",
    "offset_numerator_px": 8,
    "offset_denominator_rows": 127,
    "row_y_min": 0,
    "row_y_max": 127,
    "bottom_row_offset_px": 0,
    "top_row_offset_px": 8
  },
  "timing": {
    "cycle_duration_ns": 1000000000,
    "frames_per_cycle": 24,
    "frame_index_min": 0,
    "frame_index_max": 23,
    "frame_deadline_offset_formula": "floor(frame_index * 1000000000 / 24)",
    "frame_deadline_reference": "absolute_cycle_start",
    "scheduling_mode": "absolute_deadline",
    "cumulative_sleep_scheduling": false
  },
  "travel": {
    "bottom_row_origin_formula": "-40 + floor(frame_index * 168 / 23)",
    "frame_index_min": 0,
    "frame_index_max": 23,
    "start_bottom_row_origin_px": -40,
    "end_bottom_row_origin_px": 128,
    "travel_distance_px": 168,
    "pixel_membership": {
      "slanted_origin_formula": "bottom_row_origin + floor(row_y * 8 / 127)",
      "local_x_formula": "x - slanted_origin",
      "in_band_condition": "0 <= local_x < 32",
      "band_index_formula": "floor(local_x / 8)",
      "outside_action": "preserve_source",
      "inside_action": "recolor_only_if_source_is_FFFF"
    },
    "endpoint_blank_frames": {
      "frame_indices": [0, 23],
      "intentional": true,
      "extra_pause_inserted": false,
      "frame_0": {
        "bottom_row_origin_px": -40,
        "top_row_origin_px": -32,
        "rightmost_train_pixel_px": -1,
        "fully_offscreen_left": true
      },
      "frame_23": {
        "bottom_row_origin_px": 128,
        "top_row_origin_px": 136,
        "leftmost_train_pixel_px": 128,
        "fully_offscreen_right": true
      }
    },
    "wrap": {
      "after_frame_index": 23,
      "next_frame_index": 0,
      "extra_pause_inserted": false
    }
  },
