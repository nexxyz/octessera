+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io;
+    use std::net::{Ipv4Addr, SocketAddrV4};
+    use std::time::Duration;
+
+    #[test]
+    fn portal_activation_skips_activate_when_already_activated() {
+        let mut calls = 0;
+        let result = ensure_portal_activated(ConnectionState::Activated, || {
+            calls += 1;
+            Ok(ConnectionState::Activated)
+        });
+
+        assert!(result.is_ok());
+        assert_eq!(calls, 0);
+    }
+
+    #[test]
+    fn portal_activation_activates_once_from_activating() {
+        let mut calls = 0;
+        let result = ensure_portal_activated(ConnectionState::Activating, || {
+            calls += 1;
+            Ok(ConnectionState::Activated)
+        });
+
+        assert!(result.is_ok());
+        assert_eq!(calls, 1);
+    }
+
+    #[test]
+    fn portal_activation_rejects_non_activated_final_states() {
+        let cases = vec![
+            (ConnectionState::Activating, ConnectionState::Deactivated),
+            (ConnectionState::Unknown, ConnectionState::Unknown),
+        ];
+
+        for (initial_state, final_state) in cases.into_iter() {
+            let expected_state = format!("{:?}", final_state);
+            let activation_state = final_state.clone();
+            let mut calls = 0;
+            let error = ensure_portal_activated(initial_state, || {
+                calls += 1;
+                Ok(activation_state.clone())
+            })
+            .unwrap_err();
+
+            assert_eq!(calls, 1);
+            assert_eq!(exit_code(&error), 26);
+            assert!(error.to_string().contains(&expected_state));
+        }
+    }
+
+    #[test]
+    fn portal_activation_propagates_activate_errors() {
+        let mut activation_error: Option<network_manager::errors::Error> = Some(
+            network_manager::errors::ErrorKind::NetworkManager(
+                "activation failed".to_string(),
+            )
+            .into(),
+        );
+        let mut calls = 0;
+        let error = ensure_portal_activated(ConnectionState::Activating, || {
+            calls += 1;
+            Err(activation_error.take().unwrap().into())
+        })
+        .unwrap_err();
+
+        assert_eq!(calls, 1);
+        assert!(error.to_string().contains("activation failed"));
+        assert_eq!(exit_code(&error), 1);
+    }
+
+    #[test]
+    fn portal_address_readiness_retries_address_not_available() {
+        let address = SocketAddrV4::new(Ipv4Addr::new(192, 168, 42, 1), 80);
+        let mut attempts = 0;
+        let mut sleeps = Vec::new();
+
+        let result = wait_for_portal_address_with(
+            address,
+            Duration::from_secs(1),
+            Duration::from_millis(100),
+            |_address| {
+                attempts += 1;
+                if attempts == 1 {
+                    Err(io::Error::new(io::ErrorKind::AddrNotAvailable, "address is not ready"))
+                } else {
+                    Ok(())
+                }
+            },
+            |duration| sleeps.push(duration),
+        );
+
+        assert!(result.is_ok());
+        assert_eq!(attempts, 2);
+        assert_eq!(sleeps, vec![Duration::from_millis(100)]);
+    }
+
+    #[test]
+    fn portal_address_readiness_times_out_with_address() {
+        let address = SocketAddrV4::new(Ipv4Addr::new(192, 168, 42, 1), 80);
+        let mut attempts = 0;
+
+        let error = wait_for_portal_address_with(
+            address,
+            Duration::from_millis(0),
+            Duration::from_millis(100),
+            |_address| {
+                attempts += 1;
+                Err(io::Error::new(io::ErrorKind::AddrNotAvailable, "address is not ready"))
+            },
+            |_duration| {},
+        )
+        .unwrap_err();
+
+        assert_eq!(attempts, 1);
+        assert_eq!(exit_code(&error), 25);
+        assert!(error.to_string().contains("192.168.42.1:80"));
+    }
+
+    #[test]
+    fn portal_address_readiness_fails_immediately_for_other_errors() {
+        let address = SocketAddrV4::new(Ipv4Addr::new(192, 168, 42, 1), 80);
+        let mut attempts = 0;
+
+        let error = wait_for_portal_address_with(
+            address,
+            Duration::from_secs(10),
+            Duration::from_millis(100),
+            |_address| {
+                attempts += 1;
+                Err(io::Error::new(io::ErrorKind::AddrInUse, "port is already used"))
+            },
+            |_duration| panic!("non-transient bind errors must not sleep"),
+        )
+        .unwrap_err();
+
+        assert_eq!(attempts, 1);
+        assert_eq!(exit_code(&error), 1);
+        assert!(error.to_string().contains("192.168.42.1:80"));
+    }
+}
