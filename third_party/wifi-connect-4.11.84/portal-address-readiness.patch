+
+fn ensure_portal_activated<F>(
+    initial_state: ConnectionState,
+    mut activate: F,
+) -> Result<()>
+where
+    F: FnMut() -> Result<ConnectionState>,
+{
+    if initial_state == ConnectionState::Activated {
+        return Ok(());
+    }
+
+    let final_state = activate()?;
+    if final_state != ConnectionState::Activated {
+        bail!(ErrorKind::PortalActivation(format!("{:?}", final_state)));
+    }
+
+    Ok(())
+}
+
+fn wait_for_portal_address(gateway: Ipv4Addr, listening_port: u16) -> Result<()> {
+    let address = ::std::net::SocketAddrV4::new(gateway, listening_port);
+
+    wait_for_portal_address_with(
+        address,
+        Duration::from_secs(10),
+        Duration::from_millis(100),
+        |address| ::std::net::TcpListener::bind(address).map(|listener| drop(listener)),
+        |duration| thread::sleep(duration),
+    )
+}
+
+fn wait_for_portal_address_with<F, S>(
+    address: ::std::net::SocketAddrV4,
+    timeout: Duration,
+    interval: Duration,
+    mut bind: F,
+    mut sleep: S,
+) -> Result<()>
+where
+    F: FnMut(::std::net::SocketAddrV4) -> ::std::io::Result<()>,
+    S: FnMut(Duration),
+{
+    let deadline = ::std::time::Instant::now() + timeout;
+
+    loop {
+        match bind(address) {
+            Ok(()) => return Ok(()),
+            Err(error) if error.kind() == ::std::io::ErrorKind::AddrNotAvailable => {
+                if ::std::time::Instant::now() >= deadline {
+                    bail!(ErrorKind::PortalAddressReadinessTimeout(address.to_string()));
+                }
+                sleep(interval);
+            }
+            Err(error) => {
+                bail!(ErrorKind::PortalAddressBind(
+                    address.to_string(),
+                    error.to_string(),
+                ));
+            }
+        }
+    }
+}
